MAX_SLOTS = 1
RISK_PER_SLOT = 0.9 # Агрессивный риск для разгона
LOG_FILE = "ghost_v22_log.txt"

class TitanGhost:
    def __init__(self):
        self.memory = {
            'prices': {}, 'active_pos': {}, 'dna': {}, 'is_running': True,
            'available': 0.0, 'tp_fixed': {}, 'trail_active': {}
        }
        self.memory['vol_history'] = {} # Хранилище для rolling-объема
        self.memory['cooldown'] = {}
        self.exchange = None

    def log(self, msg):
        t = time.strftime('%H:%M:%S')
        out = f"[{t}] {msg}"
        print(out)
        with open(LOG_FILE, "a", encoding="utf-8") as f: f.write(out + "\n")

    async def init_exchange(self):
        if self.exchange:
            try: await self.exchange.close()
            except: pass
        self.exchange = ccxt.bingx({
            'apiKey': API_KEY, 'secret': API_SECRET,
            'options': {'defaultType': 'swap'}, 'enableRateLimit': True
        })
        with open('dna_ghost.json', 'r') as f: self.memory['dna'] = json.load(f)
        self.log(f"💎 TITAN GHOST V22.3 READY. Slots: {MAX_SLOTS} | Assets: {len(self.memory['dna'])}")

    async def update_context(self):
        """Синхронизация баланса и усыновление позиций BingX [V24.0]"""
        while self.memory['is_running']:
            try:
                bal = await self.exchange.fetch_balance()
                # ФИКС: Жестко пишем в 'available' для корректной работы execute_limit_entry
                self.memory['available'] = float(bal['USDT']['free'])

                # Синхронизация позиций
                pos = await self.exchange.fetch_positions()
                current_active = []
                for p in pos:
                    sym = p['symbol']
                    vol = abs(float(p['contracts']))
                    if vol > 0.00001 and sym in self.memory['dna']:
                        current_active.append(sym)

                        # Если позиция была лимиткой — подтверждаем её активацию!
                        if sym in self.memory['active_pos']:
                            if self.memory['active_pos'][sym].get('status') == 'pending':
                                self.log(f"⚡ КАПКАН СРАБОТАЛ: {sym} налит в рынок!")
                                self.memory['active_pos'][sym]['status'] = 'active'
                                self.memory['active_pos'][sym]['entry_time'] = time.time()
                        else:
                            self.log(f"🔗 RECOVERED: {sym} ({vol} units)")
                            self.memory['active_pos'][sym] = {
                                'side': p['side'].lower(), 'vol': vol, 'price': float(p['entryPrice']),
                                'entry_time': time.time(), 'dna': self.memory['dna'][sym], 'status': 'active'
                            }

                # Очистка памяти от закрытых сделок (БРОНИРОВАННАЯ ЗАЩИТА ЛИМИТОК)
                for sym in list(self.memory['active_pos'].keys()):
                    pos_data = self.memory['active_pos'][sym]
                    if sym not in current_active and pos_data.get('status') != 'pending':
                        self.log(f"🧹 Позиция {sym} закрыта извне, удаляем из памяти.")
                        del self.memory['active_pos'][sym]
                        if sym in self.memory['tp_fixed']: del self.memory['tp_fixed'][sym]
                        if sym in self.memory.get('trail_active', {}): del self.memory['trail_active'][sym]

                await asyncio.sleep(20)
            except Exception as e:
                await asyncio.sleep(5)

    async def price_stream(self):
        """Высокочастотный REST-мониторинг цен, объемов и тиковой истории [V23.0]"""
        self.log(f"📡 Запуск REST-мониторинга цен и объемов для {len(self.memory['dna'])} активов...")
        while self.memory['is_running']:
            try:
                tickers = await self.exchange.fetch_tickers(list(self.memory['dna'].keys()))
                for symbol, data in tickers.items():
                    last_price = float(data['last'])
                    self.memory['prices'][symbol] = last_price

                    q_vol = float(data['quoteVolume']) if data.get('quoteVolume') else 0.0

                    if symbol not in self.memory['vol_history']:
                        self.memory['vol_history'][symbol] = []

                    # Сохраняем КОРТЕЖ: (текущая_цена, текущий_объем)
                    self.memory['vol_history'][symbol].append((last_price, q_vol))

                    # ИСПРАВЛЕННАЯ СТРОКА: Храним строго последние 65 секунд/элементов (1 минута)
                    self.memory['vol_history'][symbol] = self.memory['vol_history'][symbol][-65:]

                await asyncio.sleep(1)
            except Exception as e:
                # self.log(f"⚠️ Ошибка потока цен: {e}")
                await asyncio.sleep(5)

    async def execute_limit_entry(self, sym, side, limit_price, dna):
        """Выставление скрытого лимитного капкана на пробойный уровень Strike"""
        try:
            # 1. Жесткая установка плеча
            await self.exchange.set_leverage(dna['lev'], sym, {'side': 'BOTH'})

            # 2. Расчет объема от доступного баланса
            avail = self.memory['available']
            usdt_vol = avail * RISK_PER_SLOT * dna['lev']
            qty = float(self.exchange.amount_to_precision(sym, usdt_vol / limit_price))
            if qty <= 0: return

            # 3. Полная зачистка старых «хвостов» перед новым капканом
            await self.exchange.cancel_all_orders(sym, {'spot': False})
            exact_price = float(self.exchange.price_to_precision(sym, limit_price))

            # 4. Выставляем Лимитный Ордер
            order = await self.exchange.create_order(sym, 'limit', side, qty, exact_price)
            if order:
                self.log(f"🕸 ЛИМИТНЫЙ КАПКАН ВЫСТАВЛЕН: {sym} {side.upper()} по {exact_price}")
                # Фиксируем как ОЖИДАЮЩИЙ ордер, а не активную позицию
                self.memory['active_pos'][sym] = {
                    'side': side, 'vol': qty, 'price': exact_price, 'entry_time': time.time(),
                    'dna': dna, 'status': 'pending'
                }
        except Exception as e:
            self.log(f"⚠ Ошибка выставления капкана {sym}: {e}")
#================
    async def hunter_loop(self):
        """Ядро сканирования Ghost Strike V23.1.2 Квантовая Геометрия [ИСПРАВЛЕНО]"""
        self.log("🚀 Охота Ghost Strike [V23.1.2 Квантовая Геометрия] активирована...")
        await asyncio.sleep(5)
        last_debug_t = 0

        while self.memory['is_running']:
            for sym, dna in self.memory['dna'].items():

                # 1. АНТИ-ПОВТОР: Кулдаун для защиты от распила
                cd_time = dna.get('cooldown', 300)
                if sym in self.memory.get('cooldown', {}) and (time.time() - self.memory['cooldown'][sym] < cd_time):
                    continue

                # 2. БЕЗОПАСНОСТЬ: Проверка свободных слотов
                if sym in self.memory['active_pos'] or len(self.memory['active_pos']) >= MAX_SLOTS:
                    continue

                try:
                    # Запрос свечей для расчета Боллинджера
                    ohlcv = await self.exchange.fetch_ohlcv(sym, '1m', limit=40)
                    df = pd.DataFrame(ohlcv, columns=['t','o','h','l','c','v'])

                    cur_p = self.memory['prices'].get(sym)
                    if not cur_p: continue

                    # Математика BB по закрытой свече (Lag-1)
                    df['ma'] = df['c'].rolling(20).mean()
                    df['std'] = df['c'].rolling(20).std()

                    ma_prev = df['ma'].iloc[-2]
                    std_prev = df['std'].iloc[-2]
                    p_up = ma_prev + (2.1 * std_prev)
                    p_dn = ma_prev - (2.1 * std_prev)
                    p_w = p_up - p_dn

                    # Ghost Strike уровни (Пространственный фильтр)
                    strike_up = p_up - (p_w * dna['ghost_p'])
                    strike_dn = p_dn + (p_w * dna['ghost_p'])

                    # 3. ДАТЧИК СКОРОСТИ И ОБЪЕМА (Tick Velocity) за 3 секунды (С ИСПРАВЛЕННЫМИ ИНДЕКСАМИ)
                    vol_history = self.memory['vol_history'].get(sym, [])
                    if len(vol_history) >= 4:
                        # Извлекаем quoteVolume (индекс 1 из кортежа)
                        diff_vol = vol_history[-1][1] - vol_history[-4][1]
                        vol_now_usdt = diff_vol if diff_vol > 0 else 0.0
                        vol_now = vol_now_usdt / cur_p

                        # Извлекаем цену (индекс 0 из кортежа) для замера скорости за 3 секунды
                        price_3s_ago = vol_history[-4][0]
                        price_change_pct = abs(cur_p / price_3s_ago - 1) if price_3s_ago > 0 else 0.0
                    else:
                        vol_now = 0.0
                        price_change_pct = 0.0

                    # Средний исторический объем в монетах
                    vol_avg = float(df['v'].rolling(10).mean().iloc[-2]) if not df['v'].empty else 0.0
                    vol_ratio = vol_now / vol_avg if vol_avg > 0 else 0

                    # Синхронизация флагов
                    open_now = df['o'].iloc[-1]
                    vol_ok = vol_ratio >= dna['vol']
                    speed_ok = price_change_pct >= dna.get('min_speed', 0.0015)

                    # Восстанавливаем чистую математику пробоя лент
                    hit_up = cur_p >= strike_up
                    hit_dn = cur_p <= strike_dn

                    # --- [АНАЛИЗАТОР ГЕОМЕТРИИ СВЕЧИ V23.1] ---
                    high_now = max(df['h'].iloc[-1], cur_p)
                    low_now = min(df['l'].iloc[-1], cur_p)
                    candle_range = high_now - low_now if (high_now - low_now) > 0 else 0.000001

                    # Геометрия фитилей и полноты тела
                    up_shadow = high_now - cur_p
                    long_body = cur_p - open_now
                    dn_shadow = cur_p - low_now
                    short_body = open_now - cur_p

                    shadow_limit = dna.get('max_shadow', 0.30)
                    body_limit = dna.get('min_body', 0.60)

                    shadow_long_ok = (up_shadow / candle_range) <= shadow_limit
                    body_long_ok = (long_body / candle_range) >= body_limit
                    shadow_short_ok = (dn_shadow / candle_range) <= shadow_limit
                    body_short_ok = (short_body / candle_range) >= body_limit

                    # Финальные триггеры жесткой свечной синхронности
                 #   is_long = hit_up and (cur_p > open_now) and vol_ok and speed_ok and shadow_long_ok and body_long_ok
                 #   is_short = hit_dn and (cur_p < open_now) and vol_ok and speed_ok and shadow_short_ok and body_short_ok

                    # Финальные триггеры жесткой свечной синхронности
                    is_long = hit_up and (cur_p > open_now) and vol_ok and speed_ok and shadow_long_ok and body_long_ok
                    is_short = hit_dn and (cur_p < open_now) and vol_ok and speed_ok and shadow_short_ok and body_short_ok
                    # --- [ПРОЗРАЧНЫЙ ДЕБАГ РАДАР V23.1.1] ---
#                    near_up = cur_p >= (strike_up * 0.985)
#                    near_dn = cur_p <= (strike_dn * 1.015)

                    # --- [ТОТАЛЬНЫЙ ДЕБАГ ВЕРИФИКАЦИИ V23.1.4] ---
                    # Радар всегда True, чтобы вытащить данные из скрытой зоны
                    near_up = True
                    near_dn = True

                    if (near_up or near_dn) and not (is_long or is_short):
                        if time.time() - last_debug_t > 15: # Опрос каждые 15 секунд
                            dist_up = (cur_p / strike_up - 1) * 100
                            dist_dn = (1 - cur_p / strike_dn) * 100

                            # Безопасный расчет процентов фитилей (Защита от ZeroDivisionError)
                            pct_up_shadow = round(up_shadow / candle_range * 100, 1) if candle_range > 0 else 0.0
                            pct_dn_shadow = round(dn_shadow / candle_range * 100, 1) if candle_range > 0 else 0.0

                            reason = f"| Тиков: {len(vol_history)} | Цена: {cur_p} | "
                            if cur_p >= strike_up and cur_p <= open_now: reason += "[Цвет не LONG ❌] "
                            if cur_p <= strike_dn and cur_p >= open_now: reason += "[Цвет не SHORT ❌] "
                            if not vol_ok: reason += f"[Объем {round(vol_ratio,1)}x < {dna['vol']}x ❌] "
                            if not speed_ok: reason += f"[Скорость {round(price_change_pct*100,3)}% < Мин ❌] "
                            if cur_p >= strike_up and not shadow_long_ok: reason += f"[Фитиль сверху {pct_up_shadow}% > 30% ❌] "
                            if cur_p <= strike_dn and not shadow_short_ok: reason += f"[Фитиль снизу {pct_dn_shadow}% > 30% ❌] "

                            self.log(f"📡 РАДАР {sym}: (Up: {round(dist_up,2)}%, Dn: {round(dist_dn,2)}%) {reason}")
                            last_debug_t = time.time()

                    # 5. ИСПОЛНЕНИЕ: Стреляем лимиткой строго при выполнении ВСЕХ условий
                    if is_long:
                        if vol_ratio < dna['vol']: continue
                        await self.execute_limit_entry(sym, 'buy', strike_up, dna)
                    elif is_short:
                        if vol_ratio < dna['vol']: continue
                        await self.execute_limit_entry(sym, 'sell', strike_dn, dna)

                except Exception as e:
                    continue
            await asyncio.sleep(0.4)
