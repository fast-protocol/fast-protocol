    async def price_stream(self):
        """Высокочастотный тотальный сбор цен BingX со сквозной фильтрацией ID [V24.1]"""
        self.log(f"📡 Запуск REST-мониторинга цен и объемов для {len(self.memory['dna'])} активов...")
        while self.memory['is_running']:
            try:
                # ЖЕСТКИЙ ФИКС: Вызываем fetch_tickers БЕЗ аргументов.
                # Это заставляет CCXT забрать ВСЕ рыночные пары BingX без вылета по ошибке Invalid Symbol!
                tickers = await self.exchange.fetch_tickers()
                if not tickers:
                    await asyncio.sleep(1)
                    continue

                for raw_symbol, data in tickers.items():
                    if not data.get('last'): continue

                    # Приводим сырой символ к каноническому виду (чистим от двоеточий)
                    clean_sym = raw_symbol.replace(':USDT', '')

                    # Проверяем, есть ли эта монета в нашей ДНК-обойме
                    # Проверка сработает для любого формата: "SOL/USDT", "SOL/USDT:USDT" или "SOLUSDT"
                    target_key = None
                    if clean_sym in self.memory['dna']: target_key = clean_sym
                    elif f"{clean_sym}:USDT" in self.memory['dna']: target_key = f"{clean_sym}:USDT"
                    elif clean_sym.replace('/', '') in self.memory['dna']: target_key = clean_sym.replace('/', '')

                    if target_key:
                        last_price = float(data['last'])
                        q_vol = float(data['quoteVolume']) if data.get('quoteVolume') else 0.0

                        # Записываем цену по обоим ключам, чтобы hunter_loop её гарантированно увидел
                        self.memory['prices'][target_key] = last_price
                        self.memory['prices'][clean_sym] = last_price

                        # Наполняем историю тиков
                        if target_key not in self.memory['vol_history']:
                            self.memory['vol_history'][target_key] = []

                        self.memory['vol_history'][target_key].append((last_price, q_vol))
                        self.memory['vol_history'][target_key] = self.memory['vol_history'][target_key][-65:]

                await asyncio.sleep(1) # Опрос раз в секунду
            except Exception as e:
                # Если произошла сетевая заминка, выводим её для прозрачности дебага
                # print(f"DEBUG PRICE STREAM ERROR: {e}")
                await asyncio.sleep(3)

    async def execute_limit_entry(self, sym, side, limit_price, dna):
        """Выставление лимитного капкана с люфтом и очисткой суффиксов V24.6.1 [BINGX]"""
        try:
            # 1. Принудительно очищаем символ от фьючерсных двоеточий CCXT
            clean_sym = sym.replace(':USDT', '')

            # --- ЖЕСТКИЙ ФИКС ДЛЯ МЕМ-ФЛАГМАНА PEPE НА BINGX ---
            if "1000PEPE" in clean_sym:
                clean_sym = clean_sym.replace("1000PEPE", "PEPE")

            # 2. Твой надежный метод установки плеча с защитой BOTH
            await self.exchange.set_leverage(dna['lev'], clean_sym, {'side': 'BOTH'})

            # 3. Добавляем микро-люфт 0.05% для гарантированного зацепа на импульсе
            if side == 'buy':
                limit_price = limit_price * 1.0005 # Ставим чуть выше для лонга
            else:
                limit_price = limit_price * 0.9995 # Ставим чуть ниже для шорта

            # 4. Расчет объема позиции от свободного капитала
            avail = self.memory['available']
            usdt_vol = avail * RISK_PER_SLOT * dna['lev']
            qty = float(self.exchange.amount_to_precision(clean_sym, usdt_vol / limit_price))
            if qty <= 0: return

            # 5. Снос старых ордеров по очищенному символу
            await self.exchange.cancel_all_orders(clean_sym, {'spot': False})
            exact_price = float(self.exchange.price_to_precision(clean_sym, limit_price))

            # 6. Отправка лимитного ордера на биржу
            order = await self.exchange.create_order(clean_sym, 'limit', side, qty, exact_price)
            if order:
                self.log(f"🕸 ЛИМИТНЫЙ КАПКАН ВЫСТАВЛЕН: {clean_sym} {side.upper()} по {exact_price} ")
                self.memory['active_pos'][sym] = {
                    'side': side, 'vol': qty, 'price': exact_price, 'entry_time': time.time(),
                    'dna': dna, 'status': 'pending'
                }
        except Exception as e:
            self.log(f"⚠ Ошибка выставления капкана {sym}: {e}")
