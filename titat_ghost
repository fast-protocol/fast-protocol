                    # Запрос свечей для расчета Боллинджера
                    ohlcv = await self.exchange.fetch_ohlcv(sym, '1m', limit=40)
#=====
                    df = pd.DataFrame(ohlcv, columns=['t','o','h','l','c','v'])

                    cur_p = self.memory['prices'].get(sym)
