MAX_SLOTS = 1
RISK_PER_SLOT = 0.9  # Агрессивный риск для разгона
LOG_FILE = "ghost_log.txt"

class TitanGhost:
    def __init__(self):
        self.memory = {
            'prices': {}, 'active_pos': {}, 'dna': {}, 'is_running': True,
            'available': 0.0, 'tp_fixed': {}, 'trail_active': {},
            'vol_history': {}, 'cooldown': {},
            'candles': {}
        }
        self.exchange = None

    def log(self, msg):
        t = time.strftime('%H:%M:%S')
        out = f"[{t}] {msg}"
        print(out, flush=True)
        try:
            with open(LOG_FILE, "a", encoding="utf-8") as f:
                f.write(out + "\n")
        except:
            pass

    async def init_exchange(self):
        if self.exchange:
            try: await self.exchange.close()
            except: pass
        self.exchange = ccxt.bingx({
            'apiKey': API_KEY, 'secret': API_SECRET,
            'options': {'defaultType': 'swap'}, 'enableRateLimit': True
        })
        with open('dna_ghost.json', 'r') as f:
            self.memory['dna'] = json.load(f)

        self.log(f"💎 TITAN GHOST V22.3 READY. Slots: {MAX_SLOTS} | Assets: {len(self.memory['dna'])}")

        # --- [ВРЕЗКА V25.9: АБСОЛЮТНЫЙ УНИВЕРСАЛЬНЫЙ ПАРСИНГ BINGX SWAP] ---
        try:
            bal = self.exchange.fetch_balance({'type': 'swap'})
            self.memory['available'] = 0.0

            if isinstance(bal, dict):
                if 'free' in bal and isinstance(bal['free'], dict) and 'USDT' in bal['free']:
                    self.memory['available'] = float(bal['free']['USDT'])
                elif 'USDT' in bal and isinstance(bal['USDT'], dict):
                    self.memory['available'] = float(bal['USDT'].get('free', 0.0))

                if self.memory['available'] <= 0 and 'info' in bal:
                    raw_info = bal['info']
                    if isinstance(raw_info, str):
                        try:
                            parsed_info = json.loads(raw_info)
                            margin_val = parsed_info.get('data', {}).get('balance', {}).get('availableMargin')
                            if margin_val is not None: self.memory['available'] = float(margin_val)
                        except: pass
                    elif isinstance(raw_info, dict):
                        margin_val = raw_info.get('data', {}).get('balance', {}).get('availableMargin')
                        if margin_val is not None: self.memory['available'] = float(margin_val)
        except Exception as e:
            self.log(f"🆘 Ошибка прогрева маржи в init_exchange: {e}")
            self.memory['available'] = 0.0

        self.log(f"💎 TITAN GHOST READY. Доступная маржа Swap: ${self.memory['available']}")

    async def update_context(self):
        """Синхронизация позиций через прямой API-шлюз аккаунта V25.9 [БЕЗ ОБНУЛЕНИЯ + ПОЛНЫЙ ВЕНИК]"""
        while self.memory['is_running']:
            try:
                bal = await self.exchange.fetch_balance({'type': 'swap'})

                # ИСТИННЫЙ ФОНОВЫЙ ОБНОВИТЕЛЬ МАРЖИ BINGX С АНТИ-КРАШ ОБЕРТКОЙ
                if isinstance(bal, dict):
                    if 'free' in bal and isinstance(bal['free'], dict) and 'USDT' in bal['free']:
                        self.memory['available'] = float(bal['free']['USDT'])
                    elif 'USDT' in bal and isinstance(bal['USDT'], dict):
                        self.memory['available'] = float(bal['USDT'].get('free', 0.0))

                    if 'info' in bal:
                        raw_info = bal['info']
                        try:
                            if isinstance(raw_info, str):
                                parsed_info = json.loads(raw_info)
                                margin_val = parsed_info.get('data', {}).get('balance', {}).get('availableMargin')
                                if margin_val is not None: self.memory['available'] = float(margin_val)
                            elif isinstance(raw_info, dict):
                                margin_val = raw_info.get('data', {}).get('balance', {}).get('availableMargin')
                                if margin_val is not None: self.memory['available'] = float(margin_val)
                        except: pass

                try: pos = await self.exchange.fetch_account_positions(None, {'type': 'swap'})
                except: pos = await self.exchange.fetch_positions(None, {'type': 'swap'})

                current_active = []
                for p in pos:
                    vol = abs(float(p.get('contracts', p.get('positionAmt', 0))))
                    if vol <= 0.00001: continue
                    raw_sym = p.get('symbol', p.get('pair', ''))

                    clean_sym = raw_sym.replace('_', '/').replace(':USDT', '')
                    if '/' not in clean_sym and 'USDT' in clean_sym:
                        clean_sym = clean_sym.replace('USDT', '/USDT')

                    dna_key = None
                    if clean_sym in self.memory['dna']: dna_key = clean_sym
                    elif f"{clean_sym}:USDT" in self.memory['dna']: dna_key = f"{clean_sym}:USDT"

                    if dna_key:
                        current_active.append(dna_key)
                        current_active.append(clean_sym)
                        entry_price = float(p.get('entryPrice', p.get('price', 0)))
                        side_raw = p.get('side', p.get('positionSide', 'LONG')).lower()
                        side = 'buy' if 'long' in side_raw or 'buy' in side_raw else 'sell'

                        if dna_key not in self.memory['active_pos']:
                            self.log(f"🔗 RECOVERED BINGX: {clean_sym} ({vol} units) успешно усыновлена!")
                            self.memory['active_pos'][dna_key] = {
                                'side': side, 'vol': vol, 'price': entry_price,
                                'entry_time': time.time(), 'dna': self.memory['dna'][dna_key], 'status': 'active'
                            }
                    else:
                        try:
                            self.log(f"🧹 ВЕНИК-ПОЗИЦИЯ: Обнаружен слепой остаток по {clean_sym} (Об ъем: {vol}). Выжигаю...")
                            side_raw = p.get('side', p.get('positionSide', 'LONG')).lower()
                            exit_side = 'sell' if 'long' in side_raw or 'buy' in side_raw else 'buy'
                            await self.exchange.create_market_order(clean_sym.replace(':USDT', ''), exit_side, vol, {'reduceOnly': True})
                        except Exception as e:
                            self.log(f"🆘 Отлуп веника по пыли {clean_sym}: {e}")

                for sym in list(self.memory['active_pos'].keys()):
                    pos_data = self.memory['active_pos'][sym]
                    if pos_data.get('status') == 'pending':
                        try:
                            open_orders = await self.exchange.fetch_open_orders(sym.replace(':USDT', ''))
                            if not open_orders and sym not in current_active:
                                self.log(f"🧹 ЭВАКУАЦИЯ: Лимитка по {sym} удалена руками. Очищаем па мять.")
                                del self.memory['active_pos'][sym]
                        except Exception: pass

                for sym in list(self.memory['active_pos'].keys()):
                    pos_data = self.memory['active_pos'][sym]
                    if sym not in current_active and pos_data.get('status') != 'pending':
                        self.log(f"🧹 Позиция {sym} закрыта на бирже. Вычищаем системные флаги.")
                        del self.memory['active_pos'][sym]
                        if sym in self.memory['tp_fixed']: del self.memory['tp_fixed'][sym]
                        if sym in self.memory.get('trail_active', {}): del self.memory['trail_active'][sym]

                await asyncio.sleep(20)
            except Exception as e:
                await asyncio.sleep(5)

    async def price_stream(self):
        """Канонический REST-шлюз обновления цен BingX из рабочей версии V27.5"""
        self.log(f"📡 Запуск REST-мониторинга цен для {len(self.memory['dna'])} активов...")
        while self.memory['is_running']:
            try:
                tickers = await self.exchange.fetch_tickers()
                if not tickers:
                    await asyncio.sleep(1)
                    continue

                for raw_symbol, data in tickers.items():
                    if not data.get('last'):
                        continue

                    # Чистим тикер до стандартов ДНК таблицы (из SOL-USDT или SOL_USDT делаем SOL/USDT:USDT)
                    clean_sym = raw_symbol.replace('_', '/').replace('-', '/')
                    if '/' in clean_sym and not clean_sym.endswith(':USDT'):
                        clean_sym = f"{clean_sym}:USDT"

                    if clean_sym in self.memory['dna']:
                        last_price = float(data['last'])
                        q_vol = float(data['quoteVolume']) if data.get('quoteVolume') else 0.0

                        # Записываем строго в оперативную память
                        self.memory['prices'][clean_sym] = last_price

                        if clean_sym not in self.memory['vol_history']:
                            self.memory['vol_history'][clean_sym] = []
                        self.memory['vol_history'][clean_sym].append([last_price, q_vol])
                        self.memory['vol_history'][clean_sym] = self.memory['vol_history'][clean_sym][-100:]

                # ЖЕСТКАЯ ИСТОРИЧЕСКАЯ РАЗГРУЗКА СЕТИ (Защита от DDoS банов BingX)
                await asyncio.sleep(3)

            except Exception as e:
                await asyncio.sleep(5)

    async def execute_limit_entry(self, sym, side, limit_price, dna):
        """Выставление лимитного капкана с фиксом 1000PEPE и защитой One-way [BINGX]"""
        try:
            # 1. Вырезаем фьючерсные двоеточия и канонизируем слэш
            clean_sym = sym.replace(':USDT', '').replace('_', '/')

            # ЖЕСТКИЙ СНАЙПЕРСКИЙ ФИКС ОФФЛАЙНА 1000PEPE
            if "1000PEPE" in clean_sym:
                clean_sym = clean_sym.replace("1000PEPE", "PEPE")

            # 2. Установка плеча в режиме Односторонней позиции BOTH
            try:
                await self.exchange.set_leverage(dna['lev'], clean_sym, {'side': 'BOTH'})
            except:
                pass

            # 3. Микро-люфт 0.05% для гарантированного зацепа импульса наружу
            if side == 'buy':
                limit_price = limit_price * 1.0005
            else:
                limit_price = limit_price * 0.9995

            # 4. Расчет объема от актуального, защищенного от нулей капитала
            avail = self.memory['available']
            usdt_vol = avail * RISK_PER_SLOT * dna['lev']
            qty = float(self.exchange.amount_to_precision(clean_sym, usdt_vol / limit_price))
            if qty <= 0: return

            # 5. Снос старых лимитных приказов
            try:
                await self.exchange.cancel_all_orders(clean_sym, {'spot': False})
            except:
                pass

            exact_price = float(self.exchange.price_to_precision(clean_sym, limit_price))

            # 6. Отправка лимитного ордера-капкана на BingX
            order = await self.exchange.create_order(clean_sym, 'limit', side, qty, exact_price)
            if order:
                self.log(f"🕸️ ЛИМИТНЫЙ КАПКАН ВЫСТАВЛЕН: {clean_sym} {side.upper()} по {exact_price }")
                self.memory['active_pos'][sym] = {
                    'side': side, 'vol': qty, 'price': exact_price, 'entry_time': time.time(),
                    'dna': dna, 'status': 'pending'
                }
        except Exception as e:
            self.log(f"⚠️ Ошибка выставления капкана {sym}: {e}")

    async def hunter_loop(self):
        """Ядро сканирования Ghost Strike V23.1.2 Квантовая Геометрия"""
        self.log("🚀 Охота Ghost Strike [V23.1.2 Квантовая Геометрия] активирована...")
        await asyncio.sleep(5)

        # Переменная для контроля частоты вывода дебаг-маяка (раз в 5 минут / 300 секунд)
        last_hunter_beacon = 0
        while self.memory['is_running']:
            now = time.time()

            # --- [ВРЕЗКА V26.0: СИСТЕМНЫЙ ДЕБАГ-МАЯК СКАНЕРА GHOST] ---
            if now - last_hunter_beacon > 300:
                active_symbols = list(self.memory['active_pos'].keys())
                self.log(f"📡 МАЯК GHOST СТАБИЛЕН: Мониторинг {len(self.memory['dna'])} секторов фьючерсов BingX.")
                self.log(f"💰 Маржа: ${round(self.memory['available'], 2)} | Занято слотов: {len(active_symbols)}/{MAX_SLOTS} | Активные ордера: {active_symbols}")
                last_hunter_beacon = now

            for sym, dna in self.memory['dna'].items():
                #self.log(f"DEBUG [2]: Сканирую монету {sym}")
                cd_time = dna.get('cooldown', 300)
                if sym in self.memory.get('cooldown', {}) and (time.time() - self.memory['cooldown'][sym] < cd_time):
                    continue

                #if sym in self.memory['active_pos'] or len(self.memory['active_pos']) >= MAX_SLOTS:
                #    continue

                # --- ЖЕСТКИЙ ШТУЧНЫЙ ФИКС V26.9.1: СHАТАЛА ОБЪЯВЛЯЕМ, ПОТОМ ПРОВЕРЯЕМ ---
                actual_positions = [k for k, v in self.memory['active_pos'].items() if v.get('status') == 'active']

                if sym in self.memory['active_pos'] or len(actual_positions) >= MAX_SLOTS:
                    continue

                try:
#===========
                    # --- КАHОHИЧЕСКИЙ СHАЙПЕРСКИЙ БЛOК GHOST V27.5 ---
                    # Живую секундную цену cur_p берем из памяти price_stream
                    cur_p = self.memory['prices'].get(sym)
                    if not cur_p or cur_p <= 0:
                        continue

                    # Выводим дебаг пульса в консоль, чтобы видеть, что сканер ЖИВ!
                    if int(time.time()) % 15 == 0:
                        self.log(f"🔍 [ПУЛЬС GHOST]: Патрулирую сектор {sym} | Живая цена: {cur_p}")

                    # Скачиваем историю свечей альта (limit=40)
                    ohlcv = await self.exchange.fetch_ohlcv(sym, '1m', limit=40)
                    if not ohlcv or len(ohlcv) < 25:
                        continue

                    df = pd.DataFrame(ohlcv, columns=['t','o','h','l','c','v'])

                    # Расчет полос Боллинджера по ПРЕДЫДУЩЕЙ ЗАКРЫТOЙ свече (индекс -2)
                    df['ma'] = df['c'].rolling(20).mean()
                    df['std'] = df['c'].rolling(20).std()

                    ma_prev = df['ma'].iloc[-2]
                    std_prev = df['std'].iloc[-2]

                    if pd.isna(ma_prev) or pd.isna(std_prev) or std_prev <= 0:
                        continue

                    p_up = ma_prev + (2.1 * std_prev)
                    p_dn = ma_prev - (2.1 * std_prev)

                    p_w = p_up - p_dn

                    strike_up = p_up - (p_w * dna['ghost_p'])
                    strike_dn = p_dn + (p_w * dna['ghost_p'])

                    # Скорость тиков и объемы за 3 секунды
                    vol_history = self.memory['vol_history'].get(sym, [])
                    if len(vol_history) >= 4:
                        diff_vol = vol_history[-1][1] - vol_history[-4][1]
                        vol_now_usdt = diff_vol if diff_vol > 0 else 0.0
                        vol_now = vol_now_usdt / cur_p
                        price_3s_ago = vol_history[-4][0]
                        price_change_pct = abs(cur_p / price_3s_ago - 1) if price_3s_ago > 0 else 0.0
                    else:
                        vol_now, price_change_pct = 0.0, 0.0

                    vol_avg = float(df['v'].rolling(10).mean().iloc[-2]) if not df['v'].empty else 0.0
                    vol_ok = (vol_now / vol_avg >= dna['vol']) if vol_avg > 0 else False
                    speed_ok = price_change_pct >= dna.get('min_speed', 0.0015)

                    hit_up = cur_p >= strike_up
                    hit_dn = cur_p <= strike_dn

                    # Геометрия свечей фитилей Marubozu
                    open_now = df['o'].iloc[-1]
                    high_now = max(df['h'].iloc[-1], cur_p)
                    low_now = min(df['l'].iloc[-1], cur_p)
                    candle_range = high_now - low_now if (high_now - low_now) > 0 else 0.000001

                    up_shadow = high_now - cur_p
                    long_body = cur_p - open_now
                    dn_shadow = cur_p - low_now
                    short_body = open_now - cur_p

                    shadow_limit = dna.get('max_shadow', 0.30)
                    body_limit = dna.get('min_body', 0.60)

                    shadow_long_ok = (up_shadow / candle_range) <= shadow_limit
                    body_long_ok = (long_body / candle_range) >= body_limit
                    shadow_short_ok = (dn_shadow / candle_range) <= shadow_limit
                    body_short_ok = (short_body / candle_range) >= body_limit

#                    is_long = hit_up and (cur_p > open_now) and vol_ok and speed_ok and shadow_long_ok and body_long_ok
#                    is_short = hit_dn and (cur_p < open_now) and vol_ok and speed_ok and shadow_short_ok and body_short_ok
                    # --- [УЗЕЛ V26.1: ИНТЕЛЛЕКТУАЛЬНЫЙ ДЕБАГ ФИЛЬТРOВ ВХОДА БИНГХ] ---
#===== БЛОК ЛОГОВ, если не надо удаляем и мнимаем  комменты для двух строк выше
                    is_long = False
                    is_short = False
                    self.log(f"🔍 [Проверка хит ап {hit_up}]).")
                    # Сценарий А: Есть пробой или касание ВЕРХНЕЙ границы Боллинджера
                    if hit_up:
                        if not (cur_p > open_now):
                            self.log(f"🔍 [ФИЛЬТР {sym}]: Отклонен шорт. Свеча не красная (Текущая цена выше открытия).")
                        elif not vol_ok:
                            self.log(f"🔍 [ФИЛЬТР {sym}]: Отклонен шорт. Не прошел объем: {round(vol_now/vol_avg, 2)}x < {dna['vol']}x")
                        elif not speed_ok:
                            self.log(f"🔍 [ФИЛЬТР {sym}]: Отклонен шорт. Не прошла тиковая скорость: {round(price_change_pct*100, 3)}% < {dna.get('min_speed', 0.0015)*100}%")
                        elif not shadow_long_ok:
                            self.log(f"🔍 [ФИЛЬТР {sym}]: Отклонен шорт. Нарушена геометрия тени фитиля: {round(up_shadow/candle_range, 2)} > {shadow_limit}")
                        elif not body_long_ok:
                            self.log(f"🔍 [ФИЛЬТР {sym}]: Отклонен шорт. Слишком слабое тело свечи Marubozu: {round(long_body/candle_range, 2)} < {body_limit}")
                        else:
                            is_long = True # Все фильтры пройдены идеально!

                    # Сценарий Б: Есть пробой или касание НИЖНЕЙ границы Боллинджера
                    if hit_dn:
                        if not (cur_p < open_now):
                            self.log(f"🔍 [ФИЛЬТР {sym}]: Отклонен лонг. Свеча не зеленая (Текущая цена ниже открытия).")
                        elif not vol_ok:
                            self.log(f"🔍 [ФИЛЬТР {sym}]: Отклонен лонг. Не прошел объем: {round(vol_now/vol_avg, 2)}x < {dna['vol']}x")
                        elif not speed_ok:
                            self.log(f"🔍 [ФИЛЬТР {sym}]: Отклонен лонг. Не прошла тиковая скорость: {round(price_change_pct*100, 3)}% < {dna.get('min_speed', 0.0015)*100}%")
                        elif not shadow_short_ok:
                            self.log(f"🔍 [ФИЛЬТР {sym}]: Отклонен лонг. Нарушена геометрия тени фитиля: {round(dn_shadow/candle_range, 2)} > {shadow_limit}")
                        elif not body_short_ok:
                            self.log(f"🔍 [ФИЛЬТР {sym}]: Отклонен лонг. Слишком слабое тело свечи Marubozu: {round(short_body/candle_range, 2)} < {body_limit}")
                        else:
                            is_short = True # Все фильтры пройдены идеально!
#=====

                    if is_long:
                        await self.execute_limit_entry(sym, 'buy', strike_up, dna)
                    elif is_short:
                        await self.execute_limit_entry(sym, 'sell', strike_dn, dna)

               # except Exception:
               #     continue
                except Exception as loop_err:
                    # --- ТОТАЛЬНЫЙ ДЕБАГ-МАРКЕР №4: ПЕРЕХВАТ СКРЫТОГО КРАША ---
                    # Если внутри try вылетает любая ошибка — мы МГНОВЕННО увидим её имя в логах!
                    self.log(f"💥 КРИТИЧЕСКИЙ СБОЙ ЦИКЛА FOR для {sym}: {loop_err}")
                    continue

            await asyncio.sleep(0.4)

    async def monitor_logic(self):
        """Асинхронный контроль выходов, безубытка и авто-утилизации болота [V25.9]"""
        while self.memory['is_running']:
            try:
                for sym in list(self.memory['active_pos'].keys()):
                    pos = self.memory['active_pos'].get(sym)
                    if not pos: continue

                    try:
                        pos_status = pos.get('status', 'active')
                        cur_p = self.memory['prices'].get(sym)
                        if not cur_p: continue

                        entry_p = float(pos['price'])
                        if pos['side'].lower() in ['buy', 'long']:
                            pnl = (cur_p / entry_p) - 1
                        else:
                            pnl = (entry_p / cur_p) - 1

                        age = time.time() - pos['entry_time']
                        dna = pos['dna']

                        # Авто-очистка зависшего болота по таймеру
                        if age >= dna.get('cut_t', 300) and pnl < dna.get('cut_p', 0.0012):
                            clean_id = sym.replace(':USDT', '')
                            if pos_status == 'pending':
                                self.log(f"🧹 СМАРТ-ФИЛЬТР: Снятие неисполненного капкана {sym} ({in t(age)}с)")
                                await self.exchange.cancel_all_orders(clean_id)
                                if sym in self.memory['active_pos']: del self.memory['active_pos'][sym]
                                self.memory['cooldown'][sym] = time.time()
                                continue
                            else:
                                try:
                                    self.log(f"⏱️ SMART-FILTER: Утилизация болотной позиции {sym} ({round(pnl*100,3)}%)")
                                    exit_side = 'sell' if pos['side'].lower() in ['buy', 'long'] else 'buy'
                                    await self.exchange.cancel_all_orders(clean_id)
                                    await self.exchange.create_market_order(clean_id, exit_side, pos['vol'], {'reduceOnly': True})
                                    self.memory['cooldown'][sym] = time.time()
                                    if sym in self.memory['active_pos']: del self.memory['active_pos'][sym]
                                    if sym in self.memory['tp_fixed']: del self.memory['tp_fixed'][sym]
                                    continue
                                except Exception as e:
                                    self.log(f"🆘 Ошибка утилизации {sym}: {e}")
                                    continue

                        if pos_status == 'pending': continue

                        # Логика Тейк-Профита 1 + Безубыток
                        if sym not in self.memory['tp_fixed'] and pnl >= dna['tp1']:
                            try:
                                self.log(f"🎯 Попытка фиксации TP1 для {sym} (PNL: {round(pnl*100,2)}%)")
                                clean_id = sym.replace(':USDT', '')
                                close_qty = float(self.exchange.amount_to_precision(sym, pos['vol'] * 0.5))
                                side_exit = 'sell' if pos['side'].lower() in ['buy', 'long'] else 'buy'

                                await self.exchange.cancel_all_orders(clean_id)
                                await self.exchange.create_market_order(clean_id, side_exit, close_qty, {'reduceOnly': True})

                                safe_bu = cur_p * 0.9995 if pos['side'].lower() in ['buy', 'long'] else cur_p * 1.0005
                                await self.exchange.create_order(clean_id, 'stop', side_exit, pos['vol']-close_qty, safe_bu, {'stopPrice': safe_bu, 'reduceOnly': True})

                                self.memory['tp_fixed'][sym] = True
                                pos['vol'] -= close_qty
                                self.log(f"✅ TP1 ВЫПОЛНЕН: {sym}. Остаток заперт в БУ.")
                            except Exception as e:
                                self.log(f"🆘 Ошибка фиксации TP1 {sym}: {e}")

                        if pnl > dna['tp1'] * 2:
                            self.memory['tp_fixed'][sym] = True

                        if pnl >= (dna['tp1'] * 2):
                            self.memory['trail_active'][sym] = True

                        # Глобальный выход по стопу или трейлингу
                        sl_trigger = dna['sl']
                        if sym in self.memory['trail_active']:
                            sl_trigger = max(sl_trigger, pnl - dna['trail'])

                        if pnl <= sl_trigger:
                            clean_id = sym.replace(':USDT', '')
                            side_exit = 'sell' if pos['side'] == 'buy' else 'buy'
                            await self.exchange.cancel_all_orders(clean_id)
                            await self.exchange.create_market_order(clean_id, side_exit, pos['vol'], {'reduceOnly': True})
                            self.log(f"🏁 EXIT INFINITY TRAIL: {sym} @ {round(pnl*100,2)}%")
                            self.memory['cooldown'][sym] = time.time()

                            if sym in self.memory['active_pos']: del self.memory['active_pos'][sym]
                            if sym in self.memory['tp_fixed']: del self.memory['tp_fixed'][sym]
                            if sym in self.memory['trail_active']: del self.memory['trail_active'][sym]
                    except Exception:
                        continue
                await asyncio.sleep(0.5)
            except Exception:
                await asyncio.sleep(1)

    async def main(self):
        """Жесткая монолитная инициализация параллельных модулей BingX V25.9"""
        await self.init_exchange()
        self.log("🔗 Запуск параллельных квантовых модулей ядра...")
        try:
            await asyncio.gather(
                self.update_context(),
                self.price_stream(),
                self.monitor_logic(),
                self.hunter_loop()
            )
        except Exception as e:
            self.log(f"❌ КРИТИЧЕСКИЙ СБОЙ ЯДРА GHOST: {e}")

if __name__ == "__main__":
    asyncio.run(TitanGhost().main())
