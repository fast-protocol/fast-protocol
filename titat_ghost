MAX_SLOTS = 1
RISK_PER_SLOT = 0.9 # Агрессивный риск для разгона
LOG_FILE = "ghost_v22_log.txt"

class TitanGhost:
    def __init__(self):
        self.memory = {
            'prices': {}, 'active_pos': {}, 'dna': {}, 'is_running': True,
            'available': 0.0, 'tp_fixed': {}, 'trail_active': {}
        }
        self.memory['vol_history'] = {} # Хранилище для rolling-объема
        self.memory['cooldown'] = {}
        self.exchange = None

    def log(self, msg):
        t = time.strftime('%H:%M:%S')
        out = f"[{t}] {msg}"
        print(out)
        with open(LOG_FILE, "a", encoding="utf-8") as f: f.write(out + "\n")

    async def init_exchange(self):
        if self.exchange:
            try: await self.exchange.close()
            except: pass
        self.exchange = ccxt.bingx({
            'apiKey': API_KEY, 'secret': API_SECRET,
            'options': {'defaultType': 'swap'}, 'enableRateLimit': True
        })
        with open('dna_ghost.json', 'r') as f: self.memory['dna'] = json.load(f)
        self.log(f"💎 TITAN GHOST V22.3 READY. Slots: {MAX_SLOTS} | Assets: {len(self.memory['dna'])}")

    async def update_context(self):
        """Синхронизация позиций через прямой API-шлюз аккаунта V25.1 [ИСПРАВЛЕНО BINGX]"""
        while self.memory['is_running']:
            try:
                # 1. Жестко запрашиваем баланс фьючерсного аккаунта Бессрочных свопов
                bal = await self.exchange.fetch_balance({'type': 'swap'})

                # БРОНИРОВАННЫЙ КВАНТОВЫЙ ПАРСИНГ ФЬЮЧЕРСНОГО БАЛАНСА В USDT
                if 'USDT' in bal and isinstance(bal['USDT'], dict):
                    self.memory['available'] = float(bal['USDT'].get('free', bal['USDT'].get('total', 0.0)))
                elif 'free' in bal and isinstance(bal['free'], dict) and 'USDT' in bal['free']:
                    self.memory['available'] = float(bal['free']['USDT'])
                else:
                    # Резервный синтаксический перебор структуры ответа BingX API
                    self.memory['available'] = float(bal.get('info', {}).get('data', {}).get('balance', {}).get('availableMargin', 0.0))

                # 2. Используем твой надежный метод fetch_account_positions для рынка swap
                try:
                    pos = await self.exchange.fetch_account_positions(None, {'type': 'swap'})
                except:
                    pos = await self.exchange.fetch_positions(None, {'type': 'swap'})

                current_active = []

                for p in pos:
                    vol = abs(float(p.get('contracts', p.get('positionAmt', 0))))
                    if vol <= 0.00001: continue

                    raw_sym = p.get('symbol', p.get('pair', ''))
                    # Приводим к каноническому виду CCXT (например, XRP/USDT)
                    clean_sym = raw_sym.replace('_', '/').replace(':USDT', '')
                    if '/' not in clean_sym and 'USDT' in clean_sym:
                        clean_sym = clean_sym.replace('USDT', '/USDT')

                    # Ищем совпадение в нашей ДНК-обойме
                    dna_key = None
                    if clean_sym in self.memory['dna']:
                        dna_key = clean_sym
                    elif f"{clean_sym}:USDT" in self.memory['dna']:
                        dna_key = f"{clean_sym}:USDT"

                    # СЦЕНАРИЙ А: Позиция наша — усыновляем или ведем
                    if dna_key:
                        current_active.append(dna_key)
                        current_active.append(clean_sym)

                        entry_price = float(p.get('entryPrice', p.get('price', 0)))
                        side_raw = p.get('side', p.get('positionSide', 'LONG')).lower()
                        side = 'buy' if 'long' in side_raw or 'buy' in side_raw else 'sell'

                        if dna_key not in self.memory['active_pos']:
                            self.log(f"🔗 RECOVERED BINGX: {clean_sym} ({vol} units) успешно усыновлена!")
                            self.memory['active_pos'][dna_key] = {
                                'side': side, 'vol': vol, 'price': entry_price,
                                'entry_time': time.time(), 'dna': self.memory['dna'][dna_key], 'status': 'active'
                            }

                    # --- [ТОТАЛЬНЫЙ ПЫЛЕСОС ПЫЛИ: ВЫЖИГАЕМ СЛЕПЫЕ ПОЗИЦИИ] ---
                    else:
                        try:
                            self.log(f"🧹 ВЕНИК-ПОЗИЦИЯ: Обнаружен слепой остаток по {clean_sym} (Об ъем: {vol}). Выжигаю...")
                            side_raw = p.get('side', p.get('positionSide', 'LONG')).lower()
                            exit_side = 'sell' if 'long' in side_raw or 'buy' in side_raw else 'buy'

                            market_id = clean_sym.replace(':USDT', '')
                            await self.exchange.create_market_order(market_id, exit_side, vol, {'reduceOnly': True})
                        except Exception as e:
                            self.log(f"🆘 Отлуп веника по пыли {clean_sym}: {e}")

                # --- [ПРОТОКОЛ АВТО-ЭВАКУАЦИИ РУЧНЫХ ЗАКРЫТИЙ ОРДЕРОВ] ---
                for sym in list(self.memory['active_pos'].keys()):
                    pos_data = self.memory['active_pos'][sym]
                    if pos_data.get('status') == 'pending':
                        try:
                            open_orders = await self.exchange.fetch_open_orders(sym.replace(':USDT', ''))
                            if not open_orders and sym not in current_active:
                                self.log(f"🧹 ЭВАКУАЦИЯ: Лимитка по {sym} удалена руками. Очищаем па мять.")
                                del self.memory['active_pos'][sym]
                        except Exception:
                            pass

                # 3. Очистка памяти от закрытых живых позиций
                for sym in list(self.memory['active_pos'].keys()):
                    pos_data = self.memory['active_pos'][sym]
                    if sym not in current_active and pos_data.get('status') != 'pending':
                        self.log(f"🧹 Позиция {sym} закрыта на бирже. Вычищаем системные флаги.")
                        del self.memory['active_pos'][sym]
                        if sym in self.memory['tp_fixed']: del self.memory['tp_fixed'][sym]
                        if sym in self.memory.get('trail_active', {}): del self.memory['trail_active'][sym]

                await asyncio.sleep(20)
            except Exception as e:
                await asyncio.sleep(5)
