async def check_signal(exchange, symbol, last_beacon_t):
    """
    Сканирование импульсов V24.0: Сплав скоростей G1/G2, Trend Altitude и 3M Volume.
    Полностью очищен от слепых зон и ложных стопов на хаях.
    """
    try:

        dna = memory.all_dna.get(symbol)
        cur_p = memory.prices.get(symbol)
        if not dna or not cur_p:
            return None, last_beacon_t
#==========================   ФИКС V149.0: ИСТИННЫЕ ЦИФРОВЫЕ ИНДЕКСЫ МАССИВА OHLCV   ============
        # Забираем скользящий 30-свечной массив из памяти сокета мимо виснущей сети интернет
        ohlcv = memory.candles.get(symbol)
        if not ohlcv or len(ohlcv) < 21:
            return None, last_beacon_t

        # Берем самую последнюю свечу из массива [-1] и извлекаем High [2] и Low [3] по HFT-индексам
        last_bar = ohlcv[-1]
        b_high = last_bar[2]
        b_low  = last_bar[3]
#----------------------------------

#==========================   ФИКС V85.0: ГИБРИДНАЯ КРOСС-КOРOБКА DNA MULTIPLIERS   ============
        global transmission_mode, manual_gear_select

        # Извлекаем индивидуальный g1-блок параметров монеты из JSON пульта
        gd = dna['g1'] if 'g1' in dna else dna

        # Контур авто-определения фазы рынка по времени сервера (UTC)
        current_hour = int(time.strftime("%H", time.gmtime()))
        is_weekend = int(time.strftime("%w", time.gmtime())) in [0, 6] # 0-Воскресенье, 6-Суббота

        active_gear = manual_gear_select
        if transmission_mode == 'AUTO':
            if is_weekend:
                active_gear = 'ECO'    # Выходной день — режим защиты маржи коэффициентами
            elif (0 <= current_hour <= 3) or (13 <= current_hour <= 16):
                active_gear = 'DRIVE'  # Будни, HFT-сессии — режим быстрого скальпинга
            else:
                active_gear = 'CRUISE' # Стандартные будни — чистый исходный ДНК-тренд

        # Наносекундное динамическое перемножение коэффициентов ОЗУ под активную фазу
        global transmission_risk_mult
        if active_gear == 'DRIVE':
            # Сжимаем тейк-1 (*0.6), поджимаем стоп (*0.8), увеличиваем риск-нагрузку
            transmission_risk_mult = 1.15
            gd['tp1']  = float(gd.get('tp1', 0.0080)) * 0.60
            gd['sl']   = float(gd.get('sl', -0.0130)) * 0.85
            gd['time'] = 180
        elif active_gear == 'ECO':
            # Расширяем тейк-1 (*1.1), раздвигаем стоп (*1.3) для защиты от шпилек ММ, режем риск
            transmission_risk_mult = 0.65
            gd['tp1']  = float(gd.get('tp1', 0.0080)) * 1.10
            gd['sl']   = float(gd.get('sl', -0.0130)) * 1.30
            gd['time'] = 450

        else:
            transmission_risk_mult = 1
            # Режим CRUISE — оставляет твои первозданные проектные настройки из JSON пульта
            pass
#================================================================================================


        # --- [ШТУЧНЫЙ ФИКС V34.2: ТОТАЛЬНЫЙ ЗАПРЕТ ПОВТОРНЫХ ВХОДОВ В ОДИН АКТИВ] ---
        if symbol in memory.active_pos or symbol.split(':')[0] in memory.active_pos:
            return None, last_beacon_t

        # ==================================================================================
        # --- [ВРЕЗКА V32.2 МОНОЛИТ: ИСПРАВЛЕННЫЙ И ЗРЯЧИЙ ДЕТЕКТОР ЛЖИ МАРКЕТ-МЕЙКЕРА] ---
