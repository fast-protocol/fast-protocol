
class GlobalMemory:
    def __init__(self):
        self.prices = {}
        self.active_pos = {}
        self.all_dna = {}
        self.is_running = True
        self.slots_occupied = 0
        self.available = 0.0
        self.start_balance = 0.0
        self.total_wallet = 0.0

        self.be_fixed = {}
        self.stop_placed = {}
        self.tp_fixed = {}

memory = GlobalMemory()

def log(msg):
    t = time.strftime('%Y-%m-%d %H:%M:%S')
    formatted = f"[{t}] 🚀 {msg}"
    print(formatted)
    try:
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(formatted + "\n")
    except:
        pass

async def update_balance(exchange):
    """Фоновое асинхронное обновление кошелька из bot_binance.py"""
    while memory.is_running:
        try:
            bal = await exchange.fetch_balance()
            total = float(bal.get('total', {}).get('USDT', 0))
            free = float(bal.get('free', {}).get('USDT', 0))

            memory.available = free
            memory.total_wallet = total

            if memory.start_balance == 0:
                memory.start_balance = free
                log(f"💰 Стартовый баланс успешно считан: ${round(free, 2)}")

        except Exception as e:
            log(f"⚠ Balance Error: {e}")
        await asyncio.sleep(20)

async def check_signal(exchange, symbol, last_beacon_t):
    """Сканирование волатильности и структуры свечи на чистом NumPy с Маяком Дебага"""
    try:
        dna = memory.all_dna.get(symbol)
        cur_p = memory.prices.get(symbol)
        if not dna or not cur_p: return None, last_beacon_t

        ohlcv = await exchange.fetch_ohlcv(symbol, '1m', limit=30)
        if len(ohlcv) < 21: return None, last_beacon_t

        df = pd.DataFrame(ohlcv, columns=['t','o','h','l','c','v'])

        ma = df['c'].rolling(20).mean().to_numpy()
        std = df['c'].rolling(20).std().to_numpy()

        p_up = ma[-2] + (2.1 * std[-2])
        p_dn = ma[-2] - (2.1 * std[-2])
        ma_prev = ma[-2]

        if std[-2] == 0 or ma_prev == 0: return None, last_beacon_t

        curr_w = (p_up - p_dn) / ma_prev * 100
        p_up_prev = ma[-3] + (2.1 * std[-3])
        p_dn_prev = ma[-3] - (2.1 * std[-3])
        prev_w = (p_up_prev - p_dn_prev) / ma[-3] * 100

        w_growth = curr_w / prev_w
        open_p = df['o'].iloc[-1]
        change = abs(cur_p / open_p - 1)

        gear = None
        if 'g2' in dna and change >= dna['g2']['speed']:
            gear = 'g2'
        elif 'g1' in dna and change >= dna['g1']['speed']:
            gear = 'g1'

        # --- [ТУМБЛЕРНЫЙ МАЯК ОХОТНИКА: РАБОТАЕТ СТРОГО ПРИ TRUE] ---
        if DEBUG_BEACONS and (time.time() - last_beacon_t > 60):
            vol_last = df['v'].iloc[-1]
            vol_avg = df['v'].mean()
            clean_name = symbol.split(':')[0]
            beacon_msg = f"🔍 МАЯК СКАНЕРА [{clean_name}]: Цена: {cur_p} | Взрыв BB: {round(w_growth,3)}x (Нужно: {dna['w_grow']}x) | Скорость: {round(change*100,3)}% "
            if gear:
                beacon_msg += f"| Передача: {gear.upper()} ✅ | Объем тика: {round(vol_last,1)} (Нужно: {round(vol_avg*dna[gear]['vol'],1)})"
            else:
                beacon_msg += f"| Скорость мала ❌"
            log(beacon_msg)
            last_beacon_t = time.time()

        if w_growth < dna['w_grow'] or not gear: return None, last_beacon_t

        if df['v'].iloc[-1] < df['v'].mean() * dna[gear]['vol']: return None, last_beacon_t

        return {
            'symbol': symbol,
            'side': 'buy' if cur_p > open_p else 'sell',
            'gear': gear,
            'price': cur_p,
            'dna': dna,
            'gear_data': dna[gear]
        }, last_beacon_t
    except:
        return None, last_beacon_t

async def execute_entry(exchange, sig):
    """Импульсный захват позиции по рынку на фьючерсах Binance"""
    symbol = sig['symbol']
    if memory.slots_occupied >= MAX_SLOTS or symbol in memory.active_pos: return

    try:
        try: await exchange.set_leverage(sig['dna']['lev'], symbol)
        except: pass

        amount_usdt = memory.available * RISK_GEAR * sig['dna']['lev']
        qty = float(exchange.amount_to_precision(symbol, amount_usdt / sig['price']))
        if qty <= 0: return

        order = await exchange.create_market_order(symbol, sig['side'], qty)
        if order:
            log(f"🔥 ВХОД [{sig['gear'].upper()}]: {symbol} {sig['side'].upper()} | Price: {sig['price']} | Vol: {qty}")

            memory.active_pos[symbol] = {
                'side': sig['side'], 'vol': qty, 'price': sig['price'],
                'gear': sig['gear'], 'gear_data': sig['gear_data'], 'dna': sig['dna'],
                'entry_time': time.time()
            }
            memory.tp_fixed[symbol] = False
            memory.be_fixed[symbol] = False
            memory.stop_placed[symbol] = None
            memory.slots_occupied += 1
    except Exception as e:
        log(f"⚠ Entry Error {symbol}: {e}")

async def monitor_logic(exchange):
    """Асинхронный бронированный контроль выходов и реальных стопов на сервере"""
    while memory.is_running:
        for symbol, pos in list(memory.active_pos.items()):
            try:
                cur_p = memory.prices.get(symbol)
                if not cur_p: continue

                pnl = (cur_p / pos['price'] - 1) if pos['side'] == 'buy' else (pos['price'] / cur_p - 1)
                gd = pos['gear_data']
                age = time.time() - pos['entry_time']
                exit_side = 'sell' if pos['side'] == 'buy' else 'buy'
                binance_market_id = symbol.replace('/', '').replace(':USDT', '')

                if not memory.stop_placed.get(symbol):
                    try:
                        sl_price = pos['price'] * (1 - abs(pos['dna']['sl'])) if pos['side'] == 'buy' else pos['price'] * (1 + abs(pos['dna']['sl']))
                        sl_price = float(exchange.price_to_precision(symbol, sl_price))

                        await exchange.fapiPrivateDeleteAlgoOpenOrders({'symbol': binance_market_id})
                        await exchange.create_order(symbol, 'STOP_MARKET', exit_side, pos['vol'], params={
                            'stopPrice': sl_price, 'reduceOnly': True
                        })
                        memory.stop_placed[symbol] = sl_price
                        log(f"🛡️ ЖЕСТКИЙ СТОП ВЫСТАВЛЕН НА БИРЖУ: {symbol} @ {sl_price}")
                    except Exception as e:
                        log(f"🆘 Ошибка автостопа {symbol}: {e}")

                if not memory.be_fixed.get(symbol, False) and pnl >= gd['step_p']:
                    try:
                        await exchange.fapiPrivateDeleteAlgoOpenOrders({'symbol': binance_market_id})
                        bu_price = float(exchange.price_to_precision(symbol, pos['price']))

                        await exchange.create_order(symbol, 'STOP_MARKET', exit_side, pos['vol'], params={
                            'stopPrice': bu_price, 'reduceOnly': True
                        })
                        memory.be_fixed[symbol] = True
                        memory.stop_placed[symbol] = bu_price
                        log(f"⚙️ ХРАПОВИК: {symbol} перенесен в БУ по цене входа {bu_price}")
                    except Exception as e:
                        log(f"⚠ Ошибка Храповика {symbol}: {e}")

                if not memory.tp_fixed[symbol] and pnl >= gd['tp1']:
                    try:
                        close_qty = exchange.amount_to_precision(symbol, pos['vol'] * 0.5)
                        await exchange.create_market_order(symbol, exit_side, close_qty, {'reduceOnly': True})

                        memory.tp_fixed[symbol] = True
                        pos['vol'] = float(exchange.amount_to_precision(symbol, pos['vol'] - float(close_qty)))
                        log(f"🎯 ТЕЙК-1 ВЫПОЛНЕН: {symbol} зафиксирован (+{round(gd['tp1']*100,2)}%)")

                        await exchange.fapiPrivateDeleteAlgoOpenOrders({'symbol': binance_market_id})
                        bu_price = float(exchange.price_to_precision(symbol, pos['price']))
                        await exchange.create_order(symbol, 'STOP_MARKET', exit_side, pos['vol'], params={
                            'stopPrice': bu_price, 'reduceOnly': True
                        })
                        memory.stop_placed[symbol] = bu_price
                    except Exception as e:
                        log(f"⚠ Ошибка TP1 {symbol}: {e}")
                #=======
                # --- [БРОНИРОВАННЫЙ МОНОЛИТ ВЫХОДОВ V21.9 — ФИКС ЗАЦИКЛИВАНИЯ] ---

                # ЛОГИКА ТЕЙК-ПРОФИТА 2 (ФИНАЛ СДЕЛКИ)
                if pnl >= gd['tp2']:
                    log(f"🏆 ТЕЙК-2 ФИНАЛ: {symbol} зафиксирован (+{round(gd['tp2']*100,2)}%)")
                    action_triggered_tp2 = False
                    try:
                        # Чистим алгоритмические стопы и кроем остаток по рынку
                        await exchange.fapiPrivateDeleteAlgoOpenOrders({'symbol': binance_market_id})
                        await exchange.create_market_order(symbol, exit_side, pos['vol'], {'reduceOnly': True})
                        action_triggered_tp2 = True
                    except Exception as e:
                        log(f"⚠ Ошибка отправки ордеров Тейка-2 для {symbol}: {e}")

                    # Тотальная очистка оперативной памяти бота при любом исходе сетевого запроса
                    if symbol in memory.active_pos: del memory.active_pos[symbol]
                    if symbol in memory.be_fixed: del memory.be_fixed[symbol]
                    if symbol in memory.stop_placed: del memory.stop_placed[symbol]
                    if symbol in memory.tp_fixed: del memory.tp_fixed[symbol]

                    memory.slots_occupied = max(0, memory.slots_occupied - 1)
                    if action_triggered_tp2: return # Намертво обрываем тик

                # ЛОГИКА ЗАТУХАНИЯ ИМПУЛЬСА ПО ТАЙМЕРУ
                if age > gd['time'] and pnl < gd['tp1'] and not memory.be_fixed.get(symbol, False):
                    log(f"⏱ ЗАТУХАНИЕ: {symbol} закрыт по таймеру (Age: {int(age)}с | PNL: {round(pnl*100,2)}%)")
                    action_triggered_decay = False
                    try:
                        # Тотально сносим защитные стопы и эвакуируем позицию
                        await exchange.fapiPrivateDeleteAlgoOpenOrders({'symbol': binance_market_id})
                        await exchange.create_market_order(symbol, exit_side, pos['vol'], {'reduceOnly': True})
                        action_triggered_decay = True
                    except Exception as e:
                        log(f"⚠ Ошибка эвакуации по таймеру для {symbol}: {e}")

                    # Полная зачистка флагов
                    if symbol in memory.active_pos: del memory.active_pos[symbol]
                    if symbol in memory.be_fixed: del memory.be_fixed[symbol]
                    if symbol in memory.stop_placed: del memory.stop_placed[symbol]
                    if symbol in memory.tp_fixed: del memory.tp_fixed[symbol]

                    memory.slots_occupied = max(0, memory.slots_occupied - 1)
                    if action_triggered_decay: return # Намертво обрываем тик
#===========
                if int(time.time()) % 15 == 0:
                    try:
                        positions = await exchange.fetch_positions()
                        live_symbols = [p['symbol'] for p in positions if abs(float(p.get('contracts', 0))) > 0.00001]
                        if symbol not in live_symbols:
                            log(f"🧹 ВЕНИК: Позиция {symbol} закрыта извне (Стоп/БУ). Очистка памяти .")
                            del memory.active_pos[symbol]
                            if symbol in memory.be_fixed: del memory.be_fixed[symbol]
                            if symbol in memory.stop_placed: del memory.stop_placed[symbol]
                            memory.slots_occupied -= 1
                    except: pass

            except Exception as e:
                pass
        await asyncio.sleep(0.5)

async def main():
    exchange = ccxt.binance({
        'apiKey': API_KEY, 'secret': API_SECRET,
        'options': {'defaultType': 'future'}, 'enableRateLimit': True
    })

    with open('dna_ignition.json', 'r') as f:
        memory.all_dna = json.load(f)

    log(f"✅ TITAN IGNITION V21.8 ONLINE. Охота на {len(memory.all_dna)} секторов.")

    async def price_stream():
        symbols = list(memory.all_dna.keys())
        last_prices_beacon = time.time()
        while memory.is_running:
            try:
                tickers = await exchange.fetch_tickers()
                for s in symbols:
                    if s in tickers and tickers[s].get('last'):
                        memory.prices[s] = float(tickers[s]['last'])

                # --- [ТУМБЛЕРНЫЙ МАЯК ПОТOKA ЦЕН: РАБОТАЕТ ПРИ TRUE] ---
                if DEBUG_BEACONS and (time.time() - last_prices_beacon > 120):
                    log(f"📡 МАЯК ЦЕН: Поток стабилен. На связи {len(memory.prices)}/{len(symbols)} секторов фьючерсного стакана.")
                    last_prices_beacon = time.time()

                await asyncio.sleep(1)
            except Exception:
                await asyncio.sleep(5)

    async def hunter_loop():
        await asyncio.sleep(5)
        last_beacon_t = 0
        while memory.is_running:
            for s in memory.all_dna.keys():
                sig, last_beacon_t = await check_signal(exchange, s, last_beacon_t)
                if sig:
                    await execute_entry(exchange, sig)
            await asyncio.sleep(0.4)

    try:
        await asyncio.gather(
            update_balance(exchange),
            price_stream(),
            hunter_loop(),
            monitor_logic(exchange)
        )
    finally:
        await exchange.close()

if __name__ == "__main__":
    asyncio.run(main())
