#==========================   ФИКС V151.0: СТЕРИЛЬНОЕ ФЬЮЧЕРСНОЕ РАЗДЕЛЕНИЕ ТИКЕРОВ   ===========
            # Вырезаем базовое имя монеты (например, "1000PEPE" или "BTC") для стрима цен
            coin_base = str(c).split('/')[0].lower()
