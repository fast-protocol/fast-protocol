async def limit_orders_cleaner_loop(exchange):
    """Изолированный круглосуточный патруль и снос протухших лимиток ДНК"""
    # Намертво глушим предупреждение CCXT оRate Limit сквозного запроса ордеров
    exchange.options["warnOnFetchOpenOrdersWithoutSymbol"] = False
#==========================   ФИКС V63.0: НАТИВНЫЙ ОДНОЗАПРОСНЫЙ СНОС БЕЗ СИМВОЛА   =============
    # Жестко подгружаем справочник контрактов CCXT в ОЗУ, чтобы избежать KeyError
    await exchange.load_markets()

    # Прямо в секунду включения бота принудительно обнуляем слоты и выжигаем зависшие хвосты RAM
    memory.slots_occupied = 0
    memory.active_pos.clear()
    memory.tp_fixed.clear()
    memory.be_fixed.clear()
    log("🧹🚀 [КВАНТОВЫЙ ВЕHИК]: Оперативная память RAM стерилизована! Слоты открыты на 100%.")


    while True:
        try:
            # 1. Запрашиваем одним быстрым запросом ВСЕ висящие ордера аккаунта
            raw_orders = await exchange.fapiPrivateGetOpenOrders()

            if raw_orders and len(raw_orders) > 0:
                current_server_time = int(time.time() * 1000) # Переводим время в миллисекунды
                orders_count = 0

                for o_data in raw_orders:
                    o_sym = str(o_data.get('symbol'))
                    o_id = o_data.get('orderId')
                    o_time = int(o_data.get('time', 0)) # Время выставления ордера биржей

                    # Проверяем жестко: ордер имеет право подлежать сносу ТОЛЬКО если пробыл в стакане более 45 сек (45000 мс)
                    if (current_server_time - o_time) >= 180000:
                        try:
                            p_params = {'symbol': o_sym, 'orderId': o_id}
                            await exchange.fapiPrivateDeleteOrder(p_params)
                            orders_count += 1
                        except:
                            pass

                if orders_count > 0:
                    log(f"🧹🔥 [ЯДЕРНЫЙ ВЕHИК V124.0]: Намертво выжжено {orders_count} реально проту хших лимиток (>45 сек)!")
                    memory.slots_occupied = 0

            await asyncio.sleep(10) # Сокращаем сон Веника до 10 сек для высокой точности патруля
        except Exception as loop_ord_err:
            await asyncio.sleep(10)

