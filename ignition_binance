
class GlobalMemory:
    def __init__(self):
        self.prices = {}
        self.active_pos = {}
        self.all_dna = {}
        self.is_running = True
        self.slots_occupied = 0
        self.available = 0.0
        self.start_balance = 0.0
        self.total_wallet = 0.0

        self.be_fixed = {}
        self.stop_placed = {}
        self.tp_fixed = {}

memory = GlobalMemory()

def log(msg):
    t = time.strftime('%Y-%m-%d %H:%M:%S')
    formatted = f"[{t}] 🚀 {msg}"
    print(formatted)
    try:
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(formatted + "\n")
    except:
        pass

async def update_balance(exchange):
    """Фоновое обновление баланса, ЖЕСТКИЙ переключатель ISOLATED и усыновление сирот V22.4"""
    first_run_sync = True
    while memory.is_running:
        try:
            # 1. Запрашиваем баланс кошелька фьючерсов
            bal = await exchange.fetch_balance()
            total = float(bal.get('total', {}).get('USDT', 0))
            free = float(bal.get('free', {}).get('USDT', 0))
            memory.available = free
            memory.total_wallet = total

            if memory.start_balance == 0:
                memory.start_balance = free
                log(f"💰 Стартовый баланс успешно считан: ${round(free, 2)}")

            # --- [ЖЕСТКИЙ ФИКС V22.4: ПРИНУДИТЕЛЬНЫЙ ФОНОВЫЙ КЛУБ ИЗОЛЯЦИИ БИНАНСА] ---
            # При каждом тике баланса бот намертво забивает режим ISOLATED для всей обоймы
            for sym in memory.all_dna.keys():
                try:
                    await exchange.set_margin_mode('ISOLATED', sym)
                except:
                    pass # Если позиция уже изолирована, биржа пропустит шаг без краша

            # --- [ШЛЮЗ СИНХРОНИЗАЦИИ ПОЗИЦИЙ ПОСЛЕ РЕСТАРТА (УСЫНОВЛЕНИЕ СИРОТ)] ---
            if first_run_sync:
                try:
                    positions = await exchange.fetch_positions()
                    for p in positions:
                        vol = abs(float(p.get('contracts', p.get('positionAmt', 0))))
                        if vol > 0.00001:
                            raw_sym = p['symbol']
                            if raw_sym not in memory.active_pos and raw_sym in memory.all_dna:
                                entry_p = float(p.get('entryPrice', p.get('price', 0)))
                                side_raw = p.get('side', p.get('positionSide', 'LONG')).lower()
                                side = 'buy' if ('long' in side_raw or 'buy' in side_raw) else 'sell'
                                dna = memory.all_dna[raw_sym]

                                memory.active_pos[raw_sym] = {
                                    'side': side, 'vol': vol, 'price': entry_p,
                                    'gear': 'g1', 'gear_data': dna['g1'], 'dna': dna,
                                    'entry_time': time.time()
                                }
                                memory.tp_fixed[raw_sym] = False
                                memory.be_fixed[raw_sym] = False
                                memory.stop_placed[raw_sym] = entry_p
                                memory.slots_occupied += 1
                                log(f"🔗 RECOVERED IGNITION: Обнаружен живой контракт по {raw_sym} ({vol} единиц). Успешно подхвачен ядром выходов!")
                except Exception as sync_err:
                    log(f"⚠ Ошибка синхронизации позиций при старте: {sync_err}")
                first_run_sync = False

            # Контрольная пауза тика опроса баланса и удержания шлюзов
            await asyncio.sleep(15)

        except Exception as e:
            log(f"⚠ Balance Error: {e}")
            await asyncio.sleep(20)

async def check_signal(exchange, symbol, last_beacon_t):
    """
    Сканирование импульсов V24.0: Сплав скоростей G1/G2, Trend Altitude и 3M Volume.
    Полностью очищен от слепых зон и ложных стопов на хаях.
    """
    try:
        dna = memory.all_dna.get(symbol)
        cur_p = memory.prices.get(symbol)
        if not dna or not cur_p:
            return None, last_beacon_t

        # 1. ЗАГРУЗКА И ВЕРИФИКАЦИЯ СВЕЧНОГО МАССИВА
        ohlcv = await exchange.fetch_ohlcv(symbol, '1m', limit=30)
        if len(ohlcv) < 21:
            return None, last_beacon_t

        df = pd.DataFrame(ohlcv, columns=['t','o','h','l','c','v'])

        # 2. РАСЧЕТ ИНДИКАТОРОВ БОЛЛИНДЖЕРА НА NUMPY
        ma_series = df['c'].rolling(20).mean()
        std_series = df['c'].rolling(20).std()

        ma = ma_series.to_numpy()
        std = std_series.to_numpy()

        ma_prev = ma[-2]
        std_prev = std[-2]

        if std_prev == 0 or ma_prev == 0 or pd.isna(ma_prev) or pd.isna(std_prev):
            return None, last_beacon_t

        p_up = ma_prev + (2.1 * std_prev)
        p_dn = ma_prev - (2.1 * std_prev)
        curr_w = (p_up - p_dn) / ma_prev * 100

        p_up_prev = ma[-3] + (2.1 * std[-3])
        p_dn_prev = ma[-3] - (2.1 * std[-3])
        if ma[-3] == 0:
            return None, last_beacon_t

        prev_w = (p_up_prev - p_dn_prev) / ma[-3] * 100
        w_growth = curr_w / prev_w

        # 3. ФИЛЬТР 1: TREND ALTITUDE SHIELD (Запрет перегретых хаев)
        # Динамически вычисляем класс риска монеты по её тикеру
        sym_upper = symbol.upper()
        if any(mem in sym_upper for mem in ['PEPE', 'WIF', 'SHIB', 'DOGE', 'NOT', 'POPCAT', 'JASMY']):
            max_alt_pct = 2.5   # Класс 1: Мемы (Предел отрыва от MA20 2.5%)
        elif any(tech in sym_upper for tech in ['SOL', 'NEAR', 'SUI', 'FET', 'TIA', 'APT', 'RNDR', 'RENDER']):
            max_alt_pct = 1.4   # Класс 2: Технологичная альта (Предел 1.4%)
        else:
            max_alt_pct = 0.8   # Класс 3: Тяжелые якоря (Предел 0.8%)

        # Измеряем текущую высоту (отрыв) живой цены от средней линии MA20
        current_altitude = abs(cur_p / ma_prev - 1) * 100

        # Если монета улетела в космос выше лимита класса — глухая блокировка ордера
        if current_altitude > max_alt_pct:
            if int(time.time()) % 30 == 0:
                log(f"🔍 [TREND SHIELD {symbol}]: Отмена! Монета перегрета ({round(current_altitude, 2)}% > {max_alt_pct}%). Пропускаем хаи.")
            return None, last_beacon_t

        # 4. ТВОЙ ОРИГИНАЛЬНЫЙ ТУМБЛЕР ДВУХ СКОРОСТЕЙ G1 / G2
        open_p = df['o'].iloc[-1]
        change = abs(cur_p / open_p - 1)
        gear = None

        if 'g2' in dna and change >= dna['g2']['speed']:
            gear = 'g2'
        elif 'g1' in dna and change >= dna['g1']['speed']:
            gear = 'g1'

        # --- [ТУМБЛЕРНЫЙ МАЯК ОХОТНИКА: ДЕБАГ-ТРАНСЛЯЦИЯ] ---
        if DEBUG_BEACONS and (time.time() - last_beacon_t > 60):
            vol_last = df['v'].iloc[-1]
            vol_avg = df['v'].mean()
            clean_name = symbol.split(':')[0]
            beacon_msg = f"🔍 МАЯК СКАНЕРА [{clean_name}]: Цена: {cur_p} | Взрыв BB: {round(w_growth,3)}x | Высота: {round(current_altitude,2)}% | Скорость: {round(change*100,3)}% "
            if gear:
                beacon_msg += f"| Передача: {gear.upper()} ✅ | Объем тика: {round(vol_last,1)} (Нужно: {round(vol_avg*dna[gear]['vol'],1)})"
            else:
                beacon_msg += f"| Скорость мала ❌"
            # log(beacon_msg)
            last_beacon_t = time.time()

        # Базовая проверка на наличие взрыва волатильности и взвода передачи
        if w_growth < dna['w_grow'] or not gear:
            return None, last_beacon_t

        # 5. ФИЛЬТР 2: НАКОПИТЕЛЬНЫЙ 3-МИНУТНЫЙ ОБЪЕМ (Уничтожение висяков)
        v_now = float(df['v'].iloc[-1])
        v_p1 = float(df['v'].iloc[-2])
        v_p2 = float(df['v'].iloc[-3])

        if v_now < v_p1 and v_p1 < v_p2:
            if int(time.time()) % 45 == 0:
                log(f"🔍 [VOLUME SHIELD {symbol}]: Отмена! Прорыв на затухающем объеме (Вялый закисающий импульс).")
            return None, last_beacon_t

        # Твоя оригинальная проверка плотности тикового объема под конкретную передачу
        if df['v'].iloc[-1] < df['v'].mean() * dna[gear]['vol']:
            return None, last_beacon_t

        # 6. ВЫЧИСЛЕНИЕ НАПРАВЛЕНИЯ КАНOНИЧЕСКОГО ИМПУЛЬСА
        is_buy_candidate = (cur_p > open_p)
        is_sell_candidate = (cur_p < open_p)

        # 7. ТВОЙ ОРИГИНАЛЬНЫЙ КАСКАДНЫЙ НOЖ (PRE-CANDLE SHIELD)
        p_c1 = df.iloc[-2]
        p_c2 = df.iloc[-3]
        p_c3 = df.iloc[-4]

        is_3_green = (p_c1['c'] > p_c1['o']) and (p_c2['c'] > p_c2['o']) and (p_c3['c'] > p_c3['o'])
        is_3_red   = (p_c1['c'] < p_c1['o']) and (p_c2['c'] < p_c2['o']) and (p_c3['c'] < p_c3['o'])

        if is_buy_candidate and is_3_red:
            return None, last_beacon_t  # Падающий каскадный нож — ловить лонг запрещено
        if is_sell_candidate and is_3_green:
            return None, last_beacon_t # Растущая ракета — шортить запрещено

        # Финальный шлюз выдачи заполненного пакета сигнала на исполнение
        return {
            'symbol': symbol,
            'side': 'buy' if is_buy_candidate else 'sell',
            'gear': gear,
            'price': cur_p,
            'dna': dna,
            'gear_data': dna[gear]
        }, last_beacon_t

    except Exception as err:
        # Полная изоляция критических сбоев расчета
        return None, last_beacon_t

async def execute_entry(exchange, sig):
    """
    Импульсный захват позиции по рынку на фьючерсах Binance V22.0.
    Исправлен баг двойного плеча, полностью убрана ошибка Code -2019.
    """
    symbol = sig['symbol']
    if memory.slots_occupied >= MAX_SLOTS or symbol in memory.active_pos:
        return

    try:
        # Принудительный стык настроек аккаунта перед входом
        try:
            await exchange.set_leverage(sig['dna']['lev'], symbol)
        except:
            pass
        try:
            await exchange.set_margin_mode('ISOLATED', symbol)
        except:
            pass

        # --- ЖЕСТКИЙ ФИКС V22.0: КАНОНИЧЕСКИЙ РАСЧЕТ ЛОТА ПОД ФЬЮЧЕРСНЫЙ КАНАЛ БИНАНСА ---
        # Для фьючерсов Binance маржинальный объем считается БЕЗ умножения на плечо,
        # так как движок биржи сам применит плечо аккаунта к переданному количеству монет!
        amount_margin_usdt = memory.available * RISK_GEAR

        # Переводим чистую маржу обеспечения в эквивалент базовых монет с учетом плеча
        raw_qty = (amount_margin_usdt * sig['dna']['lev']) / sig['price']
        qty = float(exchange.amount_to_precision(symbol, raw_qty))

        if qty <= 0:
            return

        # Открываем позицию по рынку в Isolated-режиме
        order = await exchange.create_market_order(symbol, sig['side'], qty)

        if order:
            log(f"🔥 ВХОД [{sig['gear'].upper()}]: {symbol} {sig['side'].upper()} | Price: {sig['price']} | Vol: {qty} | Общий баланс: ${round(memory.total_wallet, 2)}")
            memory.active_pos[symbol] = {
                'side': sig['side'], 'vol': qty, 'price': sig['price'],
                'gear': sig['gear'], 'gear_data': sig['gear_data'], 'dna': sig['dna'],
                'entry_time': time.time()
            }
            memory.tp_fixed[symbol] = False
            memory.be_fixed[symbol] = False
            memory.stop_placed[symbol] = None
            memory.slots_occupied += 1

    except Exception as e:
        log(f"⚠ Entry Error {symbol}: {e}")

async def monitor_logic(exchange):
    """Асинхронный бронированный контроль выходов и адаптивного пре-трейлинга V22.0 [ФИКС NEAR]"""
    while memory.is_running:
        for symbol, pos in list(memory.active_pos.items()):
            try:
                cur_p = memory.prices.get(symbol)
                if not cur_p: continue

                # Чистый расчет PNL и параметров жизни сделки
                pnl = (cur_p / pos['price'] - 1) if pos['side'] == 'buy' else (pos['price'] / cur_p - 1)
                gd = pos['gear_data']
                age = time.time() - pos['entry_time']
                exit_side = 'sell' if pos['side'] == 'buy' else 'buy'
                binance_market_id = symbol.replace('/', '').replace(':USDT', '')

                # --- [ВРЕЗКА V23.0: ИМПУЛЬСНЫЙ DECAY SHIELD ПО ВРЕМЕНИ] ---
                now_time = time.time()
               # for symbol, pos in list(memory.active_pos.items()):
                age_seconds = now_time - pos['entry_time']

                # Если позиция висит дольше 45 минут (2700 секунд)
                # и мы еще НЕ успели взвести защитный Пре-Трейлинг:
                if age_seconds > 2700 and not memory.trail_active.get(symbol, False):
                    # Живой секундный PNL
                    cur_p = memory.prices.get(symbol)
                    if cur_p:
                        profit = (cur_p / pos['price'] - 1) if pos['side'].lower() == 'buy' else (pos['price'] / cur_p - 1)

                        # Если сделка закисла во флэте (убыток не дошел до стопа, но и профита нет)
                        if profit < 0.005:
                            log(f"⏱️ [ИМПУЛЬС СДОХ]: Позиция {symbol} закисла на {round(age_seconds/60)} мин. Включаю Decay Shield эвакуации (PNL: {round(profit*100, 2)}%)")

                            # Каноническое рыночное закрытие 100% объема
                            exit_side = 'sell' if pos['side'].lower() == 'buy' else 'buy'
                            await exchange.create_market_order(symbol, exit_side, pos['vol'], {'reduceOnly': True})

                            # Чистим память
                            if symbol in memory.active_pos: del memory.active_pos[symbol]
                            continue
                # -----------------------------------------------------------

                # 1. СТАРТОВАЯ ИНИЦИАЛИЗАЦИЯ ЖЕСТКОГО СТОП-ЛОССА НА БИРЖЕ
                if not memory.stop_placed.get(symbol):
                    try:
                        sl_price = pos['price'] * (1 - abs(pos['dna']['sl'])) if pos['side'] == 'buy' else pos['price'] * (1 + abs(pos['dna']['sl']))
                        sl_price = float(exchange.price_to_precision(symbol, sl_price))
                        await exchange.fapiPrivateDeleteAlgoOpenOrders({'symbol': binance_market_id})

                        # Округляем объем строго по правилам лотов биржи
                        exact_vol = exchange.amount_to_precision(symbol, pos['vol'])
                        await exchange.create_order(symbol, 'STOP_MARKET', exit_side, exact_vol, params={
                            'stopPrice': sl_price, 'reduceOnly': True
                        })
                        memory.stop_placed[symbol] = sl_price
                        log(f"🛡️ ЖЕСТКИЙ СТОП ВЫСТАВЛЕН НА БИРЖУ: {symbol} @ {sl_price}")
                    except Exception as e:
                        log(f"🆘 КРИТИЧЕСКАЯ ОТМЕНА СТОПА БИРЖЕЙ для {symbol}: {e}")
                        # Выставляем флаг аварийно, чтобы код не застревал в цикле
                        memory.stop_placed[symbol] = pos['price']

                # --- [УЗЕЛ V22.0: АКТИВАЦИЯ ПRE-ТРЕЙЛИНГА НА 75% ПУТИ ДО ТЕЙКА 1] ---
                pre_trail_trigger = gd['tp1'] * 0.75
                if not memory.tp_fixed.get(symbol) and pnl >= pre_trail_trigger:
                    if not memory.tp_fixed.get(f"{symbol}_trail"):
                        memory.tp_fixed[f"{symbol}_trail"] = True
                        # Локально взводим максимальный PNL для скользящего шага
                        pos['max_pnl_observed'] = max(pnl, pos.get('max_pnl_observed', pnl))
                        log(f"⚡ ПРЕ-ТРЕЙЛИНГ ВЗВЕДЕН: {symbol} прошел 75% пути к цели (+{round(pnl*100,2)}%). Защита импульса активирована.")

                # Динамическое обновление пикового профита для взведенного трейлинга
                if memory.tp_fixed.get(f"{symbol}_trail"):
                    pos['max_pnl_observed'] = max(pnl, pos.get('max_pnl_observed', pnl))

                    # Жесткий снайперский шаг отката для импульсного бота (0.25% во флэте, 0.15% в bear)
                    # Если в ДНК нет market_mode, используем дефолтный безопасный шаг 0.0022 (0.22%)
                    trail_step = 0.0015 if pnl < 0 else 0.0022

                    # ПРОВЕРКА СКАТЫВАНИЯ НАЗАД: Ловушка захлопывается, фиксируем 100% объема в плюс!
                    if pnl <= (pos['max_pnl_observed'] - trail_step):
                        log(f"🏁 ГИБРИДНЫЙ ИМПУЛЬС-ТРЕЙЛИНГ: Фиксация {symbol} на развороте тренда! Итог: +{round(pnl*100,2)}% (Пик был: +{round(pos['max_pnl_observed']*100,2)}%)")
                        action_triggered_pre = False
                        try:
                            await exchange.fapiPrivateDeleteAlgoOpenOrders({'symbol': binance_market_id})
                            await exchange.create_market_order(symbol, exit_side, pos['vol'], {'reduceOnly': True})
                            action_triggered_pre = True
                        except Exception as e:
                            log(f"⚠ Ошибка закрытия импульс-трейлинга {symbol}: {e}")

                        if symbol in memory.active_pos: del memory.active_pos[symbol]
                        if symbol in memory.be_fixed: del memory.be_fixed[symbol]
                        if symbol in memory.stop_placed: del memory.stop_placed[symbol]
                        if symbol in memory.tp_fixed: del memory.tp_fixed[symbol]
                        if f"{symbol}_trail" in memory.tp_fixed: del memory.tp_fixed[f"{symbol}_trail"]

                        memory.slots_occupied = max(0, memory.slots_occupied - 1)
                        if action_triggered_pre: return

                # 2. ШТАТНАЯ ФИКСАЦИЯ ТЕЙКА 1 (С ЗАЩИТОЙ ДРОБЛЕНИЯ ЛОТА V22.3)
                if not memory.tp_fixed.get(symbol, False) and pnl >= gd['tp1']:
                    try:
                        # Считаем чистую математическую половину
                        raw_close_qty = pos['vol'] * 0.5
                        close_qty_str = exchange.amount_to_precision(symbol, raw_close_qty)
                        close_qty = float(close_qty_str)

                        # ЗАЩИТА ОКРУГЛЕНИЯ: Если половина объема округлилась в 0 или равна исходному объему
                        if close_qty <= 0 or close_qty >= pos['vol']:
                            log(f"⚠ ЛОТ {symbol} СЛИШКОМ МАЛ ДЛЯ ДРОБЛЕНИЯ ({pos['vol']}): Фиксируем 100% объема по рынку.")
                            await exchange.fapiPrivateDeleteAlgoOpenOrders({'symbol': binance_market_id})
                            await exchange.create_market_order(symbol, exit_side, pos['vol'], {'reduceOnly': True})

                            if symbol in memory.active_pos: del memory.active_pos[symbol]
                            if symbol in memory.be_fixed: del memory.be_fixed[symbol]
                            if symbol in memory.stop_placed: del memory.stop_placed[symbol]
                            if symbol in memory.tp_fixed: del memory.tp_fixed[symbol]
                            memory.slots_occupied = max(0, memory.slots_occupied - 1)
                            return

                        # Если лот позволяет дробить — идем по штатному сценарию
                        await exchange.create_market_order(symbol, exit_side, close_qty_str, {'reduceOnly': True})
                        memory.tp_fixed[symbol] = True

                        # Пересчитываем остаток
                        pos['vol'] = float(exchange.amount_to_precision(symbol, pos['vol'] - close_qty))
                        log(f"🎯 ТЕЙК-1 ВЫПОЛНЕН: {symbol} зафиксирован (+{round(gd['tp1']*100,2)}%)")

                        await exchange.fapiPrivateDeleteAlgoOpenOrders({'symbol': binance_market_id})
                        bu_price = float(exchange.price_to_precision(symbol, pos['price']))
                        await exchange.create_order(symbol, 'STOP_MARKET', exit_side, exchange.amount_to_precision(symbol, pos['vol']), params={
                            'stopPrice': bu_price, 'reduceOnly': True
                        })
                        memory.stop_placed[symbol] = bu_price
                    except Exception as e:
                        log(f"🆘 Ошибка исполнения Тейка 1 {symbol}: {e}")

                # 3. ЛОГИКА ТЕЙК-ПРОФИТА 2 (ФИНАЛ СДЕЛКИ ПРИ ИСТИННОМ ПРОБОЕ)
                if pnl >= gd['tp2']:
                    log(f"🏆 ТЕЙК-2 ФИНАЛ: {symbol} зафиксирован (+{round(gd['tp2']*100,2)}%) | Общий баланс: ${round(memory.total_wallet, 2)}")
                    action_triggered_tp2 = False
                    try:
                        await exchange.fapiPrivateDeleteAlgoOpenOrders({'symbol': binance_market_id})
                        await exchange.create_market_order(symbol, exit_side, pos['vol'], {'reduceOnly': True})
                        action_triggered_tp2 = True
                    except Exception as e:
                        log(f"⚠ Ошибка отправки ордеров Тейка-2 для {symbol}: {e}")

                    if symbol in memory.active_pos: del memory.active_pos[symbol]
                    if symbol in memory.be_fixed: del memory.be_fixed[symbol]
                    if symbol in memory.stop_placed: del memory.stop_placed[symbol]
                    if symbol in memory.tp_fixed: del memory.tp_fixed[symbol]
                    if f"{symbol}_trail" in memory.tp_fixed: del memory.tp_fixed[f"{symbol}_trail"]

                    memory.slots_occupied = max(0, memory.slots_occupied - 1)
                    if action_triggered_tp2: return

                # 4. ЛОГИКА ЗАТУХАНИЯ ИМПУЛЬСА ПО ТАЙМЕРУ (Если застряли в болоте)
                if age > gd['time'] and pnl < gd['tp1'] and not memory.be_fixed.get(symbol, False):
                    log(f"⏱️ ЗАТУХАНИЕ: {symbol} закрыт по таймеру (Age: {int(age)}с | PNL: {round(pnl*100,2)}%) | Общий баланс: ${round(memory.total_wallet, 2)}")
                    action_triggered_decay = False
                    try:
                        await exchange.fapiPrivateDeleteAlgoOpenOrders({'symbol': binance_market_id})
                        await exchange.create_market_order(symbol, exit_side, pos['vol'], {'reduceOnly': True})
                        action_triggered_decay = True
                    except Exception as e:
                        log(f"⚠ Ошибка эвакуации по таймеру для {symbol}: {e}")

                    if symbol in memory.active_pos: del memory.active_pos[symbol]
                    if symbol in memory.be_fixed: del memory.be_fixed[symbol]
                    if symbol in memory.stop_placed: del memory.stop_placed[symbol]
                    if symbol in memory.tp_fixed: del memory.tp_fixed[symbol]
                    if f"{symbol}_trail" in memory.tp_fixed: del memory.tp_fixed[f"{symbol}_trail"]

                    memory.slots_occupied = max(0, memory.slots_occupied - 1)
                    if action_triggered_decay: return

                # 5. ТВОЙ ОРИГИНАЛЬНЫЙ ВЕНИК-ОПРОС ДЛЯ ВЕРИФИКАЦИИ ИЗВНЕ ВНУТРИ ЦИКЛА FOR
                if int(time.time()) % 15 == 0:
                    try:
                        positions = await exchange.fetch_positions()
                        live_symbols = [p['symbol'] for p in positions if abs(float(p.get('contracts', 0))) > 0.00001]
                        #if symbol not in live_symbols:

                        # Нормализуем ключ, убирая / и :USDT
                        clean_live_key = symbol.replace('/', '').replace(':USDT', '')
                        if clean_live_key not in live_symbols:
                            log(f"🧹 ВЕНИК: Позиция {symbol} закрыта извне (Стоп/БУ). Очистка памяти .")
                            if symbol in memory.active_pos: del memory.active_pos[symbol]
                            if symbol in memory.be_fixed: del memory.be_fixed[symbol]
                            if symbol in memory.stop_placed: del memory.stop_placed[symbol]
                            if symbol in memory.tp_fixed: del memory.tp_fixed[symbol]
                            if f"{symbol}_trail" in memory.tp_fixed: del memory.tp_fixed[f"{symbol}_trail"]
                            memory.slots_occupied = max(0, memory.slots_occupied - 1)
                    except:
                        pass

            except Exception as e:
                pass

        await asyncio.sleep(0.5)

async def main():
    exchange = ccxt.binance({
        'apiKey': API_KEY, 'secret': API_SECRET,
        'options': {'defaultType': 'future'}, 'enableRateLimit': True
    })

    with open('dna_ignition.json', 'r') as f:
        memory.all_dna = json.load(f)

    log(f"✅ TITAN IGNITION V21.8 ONLINE. Охота на {len(memory.all_dna)} секторов.")

    async def price_stream():
        symbols = list(memory.all_dna.keys())
        last_prices_beacon = time.time()
        while memory.is_running:
            try:
                tickers = await exchange.fetch_tickers()
                for s in symbols:
                    if s in tickers and tickers[s].get('last'):
                        memory.prices[s] = float(tickers[s]['last'])

                # --- [ТУМБЛЕРНЫЙ МАЯК ПОТOKA ЦЕН: РАБОТАЕТ ПРИ TRUE] ---
                if DEBUG_BEACONS and (time.time() - last_prices_beacon > 120):
                    log(f"📡 МАЯК ЦЕН: Поток стабилен. На связи {len(memory.prices)}/{len(symbols)} секторов фьючерсного стакана.")
                    last_prices_beacon = time.time()

                await asyncio.sleep(1)
            except Exception:
                await asyncio.sleep(5)

    async def hunter_loop():
        await asyncio.sleep(5)
        last_beacon_t = 0
        while memory.is_running:
            for s in memory.all_dna.keys():
                sig, last_beacon_t = await check_signal(exchange, s, last_beacon_t)
                if sig:
                    await execute_entry(exchange, sig)
            await asyncio.sleep(0.4)

    try:
        await asyncio.gather(
            update_balance(exchange),
            price_stream(),
            hunter_loop(),
            monitor_logic(exchange)
        )
    finally:
        await exchange.close()

if __name__ == "__main__":
    asyncio.run(main())
