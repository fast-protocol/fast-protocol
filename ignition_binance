async def main():
    exchange = ccxt.binance({
        'apiKey': API_KEY, 'secret': API_SECRET,
        'options': {'defaultType': 'future'}, 'enableRateLimit': True
    })
    # --- ШТУЧНЫЙ ФИКС V24.9: АСИНХРОННЫЙ ПРОГРЕВ МАКРО-СПЕЦИФИКАЦИЙ БИНАНСА ---
    await exchange.load_markets()

    with open('dna_ignition.json', 'r') as f:
        memory.all_dna = json.load(f)

    log(f"✅ TITAN IGNITION V21.8 ONLINE. Охота на {len(memory.all_dna)} секторов.")

    async def price_stream():
        symbols = list(memory.all_dna.keys())
        last_prices_beacon = time.time()
        while memory.is_running:
            try:
                tickers = await exchange.fetch_tickers()
                for s in symbols:
                    if s in tickers and tickers[s].get('last'):
                        memory.prices[s] = float(tickers[s]['last'])

                # --- [ТУМБЛЕРНЫЙ МАЯК ПОТOKA ЦЕН: РАБОТАЕТ ПРИ TRUE] ---
                if DEBUG_BEACONS and (time.time() - last_prices_beacon > 120):
                    log(f"📡 МАЯК ЦЕН: Поток стабилен. На связи {len(memory.prices)}/{len(symbols)} секторов фьючерсного стакана.")
                    last_prices_beacon = time.time()

                await asyncio.sleep(1)
            except Exception:
                await asyncio.sleep(5)

    async def hunter_loop():
        await asyncio.sleep(5)
        last_beacon_t = 0
        while memory.is_running:
            for s in memory.all_dna.keys():
                sig, last_beacon_t = await check_signal(exchange, s, last_beacon_t)
                if sig:
                    await execute_entry(exchange, sig)
            await asyncio.sleep(0.4)

    try:
        await asyncio.gather(
            update_balance(exchange),
            price_stream(),
            hunter_loop(),
            monitor_logic(exchange)
        )
    finally:
        await exchange.close()

if __name__ == "__main__":
    asyncio.run(main())
