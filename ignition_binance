# --- КВАНТОВЫЕ НАСТРОЙКИ ЯДРА ---
RISK_GEAR = 0.70       # Доля депо на одну сделку (12%)
MAX_SLOTS = 2          # Максимум 4 параллельных сделки
LOG_FILE = "ignition_log.txt"
# --- ЖЕСТКИЙ ЛИМИТ КРЕДИТНОГО ПЛЕЧА СУБАККАУНТА BINANCE ---
MAX_ACCOUNT_LEVERAGE = 20  # Выставляем 5х (аппаратный потолок субаккаунта)

# --- ТУМБЛЕР РЕЖИМА ДЕБАГА (ВКЛ / ВЫКЛ) ---
DEBUG_BEACONS = False   # Сделай False, чтобы полностью выключить маяки в консоли

class GlobalMemory:
    def __init__(self):
        self.prices = {}
        self.active_pos = {}
        self.all_dna = {}
        self.is_running = True
        self.slots_occupied = 0
        self.available = 0.0
        self.start_balance = 0.0
        self.total_wallet = 0.0

        self.be_fixed = {}
        self.stop_placed = {}
        self.tp_fixed = {}

memory = GlobalMemory()

def log(msg):
    t = time.strftime('%Y-%m-%d %H:%M:%S')
    formatted = f"[{t}] 🚀 {msg}"
    print(formatted)
    try:
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(formatted + "\n")
    except:
        pass

async def update_balance(exchange):
    """Фоновое обновление баланса, ЖЕСТКИЙ переключатель ISOLATED и усыновление сирот V22.4"""
    first_run_sync = True
    while memory.is_running:
        try:
            # 1. Запрашиваем баланс кошелька фьючерсов

            # --- ШТУЧНЫЙ ФИКС V24.9: КВАНТОВЫЙ СЪЕМ ДОСТУПНОЙ МАРЖИ BINANCE ---
            bal = await exchange.fetch_balance()

            # Извлекаем аппаратный availableBalance фьючерсного шлюза Binance
            m_info = bal.get('info', {})
            assets = m_info.get('assets', [])

            # Ищем чистую доступную маржу Isolated-активов среди JSON-массива биржи
            usdt_asset = next((a for a in assets if a.get('asset') == 'USDT'), {})
            avail_margin = float(usdt_asset.get('availableBalance', bal.get('free', {}).get('USDT', 0)))

            # Возвращаем переменную free для предотвращения NameError ниже по коду
            free = avail_margin

            # Резервируем скрытый 3% буфер на Slippage проскальзывание рыночного ордера Taker
            memory.available = avail_margin * 0.97
            memory.total_wallet = float(bal.get('total', {}).get('USDT', 0))

            if memory.start_balance == 0:
                memory.start_balance = free
                log(f"💰 Стартовый баланс успешно считан: ${round(free, 2)}")

            # --- [ЖЕСТКИЙ ФИКС V22.4: ПРИНУДИТЕЛЬНЫЙ ФОНОВЫЙ КЛУБ ИЗОЛЯЦИИ БИНАНСА] ---
            # При каждом тике баланса бот намертво забивает режим ISOLATED для всей обоймы
            for sym in memory.all_dna.keys():
                try:
                    await exchange.set_margin_mode('ISOLATED', sym)
                except:
                    pass # Если позиция уже изолирована, биржа пропустит шаг без краша

            # --- [ШЛЮЗ СИНХРОНИЗАЦИИ ПОЗИЦИЙ ПОСЛЕ РЕСТАРТА (УСЫНОВЛЕНИЕ СИРОТ)] ---
            if first_run_sync:
                try:
                    positions = await exchange.fetch_positions()
                    for p in positions:
                        vol = abs(float(p.get('contracts', p.get('positionAmt', 0))))
                        if vol > 0.00001:
                            raw_sym = p['symbol']
                            if raw_sym not in memory.active_pos and raw_sym in memory.all_dna:
                                entry_p = float(p.get('entryPrice', p.get('price', 0)))
                                side_raw = p.get('side', p.get('positionSide', 'LONG')).lower()
                                side = 'buy' if ('long' in side_raw or 'buy' in side_raw) else 'sell'
                                dna = memory.all_dna[raw_sym]

                                memory.active_pos[raw_sym] = {
                                    'side': side, 'vol': vol, 'price': entry_p,
                                    'gear': 'g1', 'gear_data': dna['g1'], 'dna': dna,
                                    'entry_time': time.time()
                                }
                                memory.tp_fixed[raw_sym] = False
                                memory.be_fixed[raw_sym] = False
                                memory.stop_placed[raw_sym] = entry_p
                                memory.slots_occupied += 1
                                log(f"🔗 RECOVERED IGNITION: Обнаружен живой контракт по {raw_sym} ({vol} единиц). Успешно подхвачен ядром выходов!")
                except Exception as sync_err:
                    log(f"⚠ Ошибка синхронизации позиций при старте: {sync_err}")
                first_run_sync = False

            # Контрольная пауза тика опроса баланса и удержания шлюзов
            await asyncio.sleep(15)

        except Exception as e:
            log(f"⚠ Balance Error: {e}")
            await asyncio.sleep(20)

async def check_signal(exchange, symbol, last_beacon_t):
    """
    Сканирование импульсов V24.0: Сплав скоростей G1/G2, Trend Altitude и 3M Volume.
    Полностью очищен от слепых зон и ложных стопов на хаях.
    """
    try:
        dna = memory.all_dna.get(symbol)
        cur_p = memory.prices.get(symbol)
        if not dna or not cur_p:
            return None, last_beacon_t

        # --- [ШТУЧНЫЙ ФИКС V34.2: ТОТАЛЬНЫЙ ЗАПРЕТ ПОВТОРНЫХ ВХОДОВ В ОДИН АКТИВ] ---
        if symbol in memory.active_pos or symbol.split(':')[0] in memory.active_pos:
            return None, last_beacon_t

        # ==================================================================================
        # --- [ВРЕЗКА V32.2 МОНОЛИТ: ИСПРАВЛЕННЫЙ И ЗРЯЧИЙ ДЕТЕКТОР ЛЖИ МАРКЕТ-МЕЙКЕРА] ---
        # ==================================================================================
        try:
            # --- КОНТУР 1: СПОТ-ФЬЮЧЕРСНЫЙ АРБИТРАЖНЫЙ ШЛЮЗ (SPOOFING DETECTOR) ---
            # Извлекаем легитимный спотовый тикер CCXT стандарта Бинанса (например, "SOL/USDT")
            spot_symbol = str(symbol).split(':')[0]

            # Вытягиваем живую спотовую цену из нашей RAM-памяти сокетов
            spot_price_raw = memory.prices.get(spot_symbol, memory.prices.get(spot_symbol.replace('/', '')))

            if spot_price_raw and float(spot_price_raw) > 0:
                spot_price = float(spot_price_raw)
                # Рассчитываем наносекундный рассинхрон цены фьючерса и спота
                basis_pct = abs(cur_p / spot_price - 1.0) * 100.0

                # Если фьючерс оторвался от реального спота более чем на 0.25% — это фантомный сквиз ММ
                if basis_pct >= 0.25:
                    log(f"🛑 [SPOOFING SHIELD]: Отмена входа по {symbol}! Обнаружен фантомный сквиз фьючерса. Фьюч: {cur_p} | Спот: {spot_price} | Базис: {round(basis_pct, 3)}% > 0.25%")
                    return None, last_beacon_t

            log(f"⚙️ [DEBUG 2]: {symbol} прошел Спот-Шлюз. Запрашиваю стакан...")


            # --- КОНТУР 2: СВЕРХСКОРОСТНОЙ ШЛЮЗ ПЛОТНОСТИ ОЗУ (БЕЗ СЕТЕВЫХ ЛАГОВ BINANCE) ---
            # Измеряем спред на основе живого сокет-пакета, полностью заменяя fetch_order_book
            # Если ММ выдернет лимитки (воздушная яма), сокет-спред мгновенно расширится
            spot_ticker_key = str(symbol).split(':')[0].replace('/', '')
            live_ticker_data = memory.prices.get(spot_ticker_key + "_full", {})

            # Если биржа передает расширенный спред между лучшим Bid и Ask в сокетах более 0.4%
            if live_ticker_data:
                bid = float(live_ticker_data.get('b', 0))
                ask = float(live_ticker_data.get('a', 0))
                if bid > 0 and ask > 0:
                    spread_pct = abs(ask / bid - 1.0) * 100.0
                    if spread_pct >= 0.40:
                        log(f"🧹 [DELTA DEPTH SHIELD]: Отмена входа по {symbol}! Воздушная яма спред а в сокетах ММ. Спред: {round(spread_pct, 3)}% >= 0.4%")
                        return None, last_beacon_t

            # --- КОНТУР 3: СКОРОСТЬ ДЕЛЬТЫ ОБЪЕМА (VOLUME VELOCITY DELTA V34.0) ---
            # Извлекаем объем текущей минутной свечи (первые секунды импульса)
            v_now = float(df['v'].iloc[-1])
            v_mean = float(df['v'].mean())

            # Если цена летит, но объем первого тика вялый (меньше среднего в 1.8 раза) — это пустой сквиз ММ
            if v_now < (v_mean * 1.8):
                log(f"🧹 [VOLUME VELOCITY]: Отмена входа по {symbol}! Импульс пустой, ММ гонит цену  через вакуум. Vol: {round(v_now,1)} < Требуемого: {round(v_mean * 1.8, 1)}")
                return None, last_beacon_t

            log(f"⚙️ [DEBUG 3]: {symbol} получил стакан успешно. Проверяю объемы...")

        except Exception as mm_detect_err:
            # Аварийный шлюз: если API Бинанса лагает на запросе стакана, не рискуем маржой
            return None, last_beacon_t
        # ==================================================================================

#        log(f"⚙️ [DEBUG 4]: {symbol} прошел все ММ-фильтры! Проверяю Динамический Нож...")


        # 1. ЗАГРУЗКА И ВЕРИФИКАЦИЯ СВЕЧНОГО МАССИВА
        ohlcv = await exchange.fetch_ohlcv(symbol, '1m', limit=30)
        if len(ohlcv) < 21:
            return None, last_beacon_t

        df = pd.DataFrame(ohlcv, columns=['t','o','h','l','c','v'])

        # 2. РАСЧЕТ ИНДИКАТОРОВ БОЛЛИНДЖЕРА НА NUMPY
        ma_series = df['c'].rolling(20).mean()
        std_series = df['c'].rolling(20).std()

        ma = ma_series.to_numpy()
        std = std_series.to_numpy()

        ma_prev = ma[-2]
        std_prev = std[-2]

        if std_prev == 0 or ma_prev == 0 or pd.isna(ma_prev) or pd.isna(std_prev):
            return None, last_beacon_t

        p_up = ma_prev + (2.1 * std_prev)
        p_dn = ma_prev - (2.1 * std_prev)
        curr_w = (p_up - p_dn) / ma_prev * 100

        p_up_prev = ma[-3] + (2.1 * std[-3])
        p_dn_prev = ma[-3] - (2.1 * std[-3])
        if ma[-3] == 0:
            return None, last_beacon_t

        prev_w = (p_up_prev - p_dn_prev) / ma[-3] * 100
        w_growth = curr_w / prev_w

        # 3. ФИЛЬТР 1: TREND ALTITUDE SHIELD (Запрет перегретых хаев)
        # Динамически вычисляем класс риска монеты по её тикеру
        sym_upper = symbol.upper()
        if any(mem in sym_upper for mem in ['1000PEPE', 'WIF', '1000SHIB', '1000BONK', '1000FLOKI','DOGE', 'NOT', 'POPCAT', 'JASMY']):
            max_alt_pct = 2.5   # Класс 1: Мемы (Предел отрыва от MA20 2.5%)
        elif any(tech in sym_upper for tech in ['SOL', 'NEAR', 'SUI', 'FET', 'TIA', 'APT', 'OP', 'RENDER']):
            max_alt_pct = 1.4   # Класс 2: Технологичная альта (Предел 1.4%)
        else:
            max_alt_pct = 0.8   # Класс 3: Тяжелые якоря (Предел 0.8%)

        # Измеряем текущую высоту (отрыв) живой цены от средней линии MA20
        current_altitude = abs(cur_p / ma_prev - 1) * 100

        # Если монета улетела в космос выше лимита класса — глухая блокировка ордера
        if current_altitude > max_alt_pct:
            if int(time.time()) % 30 == 0:
                log(f"🔍 [TREND SHIELD {symbol}]: Отмена! Монета перегрета ({round(current_altitude, 2)}% > {max_alt_pct}%). Пропускаем хаи.")
            return None, last_beacon_t

        # 4. ТВОЙ ОРИГИНАЛЬНЫЙ ТУМБЛЕР ДВУХ СКОРОСТЕЙ G1 / G2
        open_p = df['o'].iloc[-1]
        change = abs(cur_p / open_p - 1)
        gear = None

        if 'g2' in dna and change >= dna['g2']['speed']:
            gear = 'g2'
        elif 'g1' in dna and change >= dna['g1']['speed']:
            gear = 'g1'

        # --- [ТУМБЛЕРНЫЙ МАЯК ОХОТНИКА: ДЕБАГ-ТРАНСЛЯЦИЯ] ---
        if DEBUG_BEACONS and (time.time() - last_beacon_t > 60):
            vol_last = df['v'].iloc[-1]
            vol_avg = df['v'].mean()
            clean_name = symbol.split(':')[0]
            beacon_msg = f"🔍 МАЯК СКАНЕРА [{clean_name}]: Цена: {cur_p} | Взрыв BB: {round(w_growth,3)}x | Высота: {round(current_altitude,2)}% | Скорость: {round(change*100,3)}% "
            if gear:
                beacon_msg += f"| Передача: {gear.upper()} ✅ | Объем тика: {round(vol_last,1)} (Нужно: {round(vol_avg*dna[gear]['vol'],1)})"
            else:
                beacon_msg += f"| Скорость мала ❌"
            # log(beacon_msg)
            last_beacon_t = time.time()

        # Базовая проверка на наличие взрыва волатильности и взвода передачи
        if w_growth < dna['w_grow'] or not gear:
            return None, last_beacon_t

        # 5. ФИЛЬТР 2: НАКОПИТЕЛЬНЫЙ 3-МИНУТНЫЙ ОБЪЕМ (Уничтожение висяков)
        v_now = float(df['v'].iloc[-1])
        v_p1 = float(df['v'].iloc[-2])
        v_p2 = float(df['v'].iloc[-3])

        if v_now < v_p1 and v_p1 < v_p2:
            if int(time.time()) % 45 == 0:
                log(f"🔍 [VOLUME SHIELD {symbol}]: Отмена! Прорыв на затухающем объеме (Вялый закисающий импульс).")
            return None, last_beacon_t

        # Твоя оригинальная проверка плотности тикового объема под конкретную передачу
        if df['v'].iloc[-1] < df['v'].mean() * dna[gear]['vol']:
            return None, last_beacon_t

        # 6. ВЫЧИСЛЕНИЕ НАПРАВЛЕНИЯ КАНOНИЧЕСКОГО ИМПУЛЬСА
        is_buy_candidate = (cur_p > open_p)
        is_sell_candidate = (cur_p < open_p)

        # 7. ТВОЙ ОРИГИНАЛЬНЫЙ КАСКАДНЫЙ НOЖ (PRE-CANDLE SHIELD)
        p_c1 = df.iloc[-2]
        p_c2 = df.iloc[-3]
        p_c3 = df.iloc[-4]

        is_3_green = (p_c1['c'] > p_c1['o']) and (p_c2['c'] > p_c2['o']) and (p_c3['c'] > p_c3['o'])
        is_3_red   = (p_c1['c'] < p_c1['o']) and (p_c2['c'] < p_c2['o']) and (p_c3['c'] < p_c3['o'])

        # --- [ВРЕЗКА V34.0: ИНТЕЛЛЕКТУАЛЬНЫЙ ДИНАМИЧЕСКИЙ КАСКАДНЫЙ НОЖ С ПРИВЯЗКОЙ К MA20] ---
        # Контур Лонга: если 3 свечи красные, но мы ВЫШЕ MA20 (в благоприятной зоне) — вход разрешен!
        # Блокировка включится, только если мы упали под MA20 (в неблагоприятную зону)
        if is_buy_candidate and is_3_red and cur_p <= ma_prev:
            log(f"🪓 [DYNAMIC KNIFE]: Отмена Лонга по {symbol}! Каскад 3 свечей на лоу канала Боллин джера (Ниже MA20). Цена: {cur_p} <= MA20: {round(ma_prev, 4)}")
            return None, last_beacon_t

        # Контур Шорта: если 3 свечи зеленые, но мы НИЖЕ MA20 (благоприятная зона разгона) — вход разрешен!
        # Намертво блокируем шорт, только если цена находится на самых хаях канала (выше MA20)
        if is_sell_candidate and is_3_green and cur_p >= ma_prev:
            log(f"🪓 [DYNAMIC KNIFE]: Отмена Шорта по {symbol}! Каскад 3 свечей на хаях канала Болли нджера (Выше MA20). Цена: {cur_p} >= MA20: {round(ma_prev, 4)}")
            return None, last_beacon_t

        # Финальный шлюз выдачи заполненного пакета сигнала на исполнение
        return {
            'symbol': symbol,
            'side': 'buy' if is_buy_candidate else 'sell',
            'gear': gear,
            'price': cur_p,
            'dna': dna,
            'gear_data': dna[gear]
        }, last_beacon_t

    except Exception as err:
        # Полная изоляция критических сбоев расчета
        return None, last_beacon_t

async def execute_entry(exchange, sig):
    """
    Импульсный захват позиции по рынку на фьючерсах Binance V24.9.5.
    Возврат к рабочей архитектуре create_market_order с прецизией лота.
    """
    raw_symbol = sig['symbol']

    # КАНОНИЧЕСКИЙ ОЧИСТИТЕЛЬ ТИКЕРА: Приводим 'LINK/USDT:USDT' к биржевому формату 'LINK/USDT'
    symbol = raw_symbol.split(':')[0]

    if memory.slots_occupied >= MAX_SLOTS or symbol in memory.active_pos:
        return

    try:
        # 1. Динамическое определение эффективного плеча с учетом лимита субаккаунта
        dna_lev = int(sig['dna']['lev'])
        effective_leverage = min(dna_lev, MAX_ACCOUNT_LEVERAGE)

        # Принудительный базовый стык плеча и Isolated-маржи на Бинансе
        try: await exchange.set_leverage(effective_leverage, symbol)
        except: pass
        try: await exchange.set_margin_mode('ISOLATED', symbol)
        except: pass

        # 2. МАТЕМАТИЧЕСКИЙ РАСЧЕТ НОМИНАЛЬНОГО ОБЪЕМА ПОД РЕАЛЬНОЕ ПЛЕЧО
        amount_usdt = memory.available * RISK_GEAR * effective_leverage

        # Переводим объем в эквивалент базовых монет под реальное плечо 5х
        raw_qty = amount_usdt / sig['price']

        # Округляем строго по фьючерсным шагам Бинанса, используя очищенный тикер
        qty = float(exchange.amount_to_precision(symbol, raw_qty))

        if qty <= 0:
            return

        # --- ШТУЧНЫЙ КВАНТОВЫЙ ДЕБАГ V25.0: ВСКРЫТИЕ МАРЖИНАЛЬНОЙ СЛЕПОТЫ ---
        log(f"🔍 [DEBUG ENTRY]: Available Margin: ${round(memory.available, 4)} | RISK_GEAR: {RISK_GEAR}")
        log(f"🔍 [DEBUG ENTRY]: Target Leverage: {sig['dna']['lev']}x | Price: {sig['price']}")
        log(f"🔍 [DEBUG ENTRY]: Calculated Nom Volume (with leverage): ${round(amount_usdt, 2)}")
        log(f"🔍 [DEBUG ENTRY]: FINAL ROUNDED QTY TO BINANCE: {qty} монет")
        # 3. ИСПОЛНИТЕЛЬНЫЙ КАНАЛ: Возвращаем проверенный create_market_order из старого рабочего бота!
        order = await exchange.create_market_order(symbol, sig['side'], qty)

        if order:
            log(f"🔥 ВХОД [{sig['gear'].upper()}]: {symbol} {sig['side'].upper()} | Price: {sig['price']} | Vol: {qty} | Общий баланс: ${round(memory.total_wallet, 2)}")

            # Записываем сделку в RAM под чистым биржевым ключом
            memory.active_pos[raw_symbol] = {
                'side': sig['side'], 'vol': qty, 'price': sig['price'],
                'gear': sig['gear'], 'gear_data': sig['gear_data'], 'dna': sig['dna'],
                'entry_time': time.time()
            }
            memory.tp_fixed[symbol] = False
            memory.be_fixed[symbol] = False
            memory.stop_placed[symbol] = None
            memory.slots_occupied += 1

    except Exception as e:
        log(f"⚠ Entry Error {symbol}: {e}")

