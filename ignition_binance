 #           'gear': gear,
 #           'price': cur_p,
 #           'dna': dna,
 #           'gear_data': dna[gear]
 #       }, last_beacon_t

    except Exception as err:
        # Полная изоляция критических сбоев расчета
        return None, last_beacon_t

async def execute_entry(exchange, sig):
    """
    Импульсный захват позиции по рынку на фьючерсах Binance V40.0.
    Безошибочный монолит с проверкой маржи и фиксом косой черты плеч.
    """
    # 1. АППАРАТНЫЙ ПРЕДОХРАНИТЕЛЬ: Выполняется до любых расчетов маржи кошелька
    try:
        bal_info = await exchange.fetch_balance()
        live_available = float(bal_info.get('info', {}).get('availableBalance', 0))
        if live_available < 2.0:
            # Бесшумный выход, если Бинанс лагает или маржи реально мало
            return
    except:
        return

    raw_symbol = sig['symbol']
    # Очищаем тикер для внутренних RAM флагов ('LINK/USDT')
    symbol = raw_symbol.split(':')[0]

    if memory.slots_occupied >= MAX_SLOTS or symbol in memory.active_pos:
        return

    try:
        # СБОР ЖЕСТКОГО БИРЖЕВОГО ID КОНТРАКТА ДЛЯ МЕТОДОВ ПЛЕЧА BINANCE ('ADAUSDT')
        binance_id_clean = str(symbol).replace('/', '')

        # Динамическое определение эффективного плеча с учетом лимита субаккаунта
        dna_lev = int(sig['dna']['lev'])
        effective_leverage = min(dna_lev, MAX_ACCOUNT_LEVERAGE)

        # Очищаем тикер от косой черты специально для API Бинанса
        binance_id_clean = str(symbol).replace('/', '')
        try: await exchange.set_leverage(effective_leverage, binance_id_clean)
        except: pass
        try: await exchange.set_margin_mode('ISOLATED', binance_id_clean)
        except: pass

        # МАТЕМАТИЧЕСКИЙ РАСЧЕТ НОМИНАЛЬНОГО ОБЪЕМА ПОД ОБНОВЛЕННУЮ МАРЖУ ОЗУ
#        amount_usdt = memory.available * RISK_GEAR * effective_leverage
        amount_usdt = float(live_available) * RISK_GEAR * effective_leverage

        # Переводим объем в эквивалент базовых монет
        raw_qty = amount_usdt / sig['price']

        # Округляем строго по фьючерсным шагам Бинанса, используя стандартный тикер
        qty = float(exchange.amount_to_precision(symbol, raw_qty))
        if qty <= 0:
            return

        # --- ШТУЧНЫЙ КВАНТОВЫЙ ДЕБАГ V40.0: ВСКРЫТИЕ МАРЖИНАЛЬНОЙ СЛЕПОТЫ ---
        log(f"🔍 [Debug entry]: Available Margin: ${round(live_available, 4)} | RISK_GEAR: {RISK_GEAR}")
        log(f"🔍 [Debug entry]: Target Leverage: {sig['dna']['lev']}x | Price: {sig['price']}")
        log(f"🔍 [Debug entry]: Calculated Nom Volume (with leverage): ${round(amount_usdt, 2)}")
        log(f"🔍 [Debug entry]: FINAL ROUNDED QTY TO BINANCE: {qty} монет")

        # ИСПОЛНИТЕЛЬНЫЙ КАНАЛ: Рыночный приказ входа

#        order = await exchange.create_market_order(symbol, sig['side'], qty)

        # ИСПОЛНИТЕЛЬНЫЙ ШЛЮЗ V43.0: МАРКЕТ В РАКЕТУ / ПАССИВНЫЙ ЛИМИТ В ОТКАТ
        g_type = sig.get('gear_type', 'MARKET')
        if g_type == 'MARKET':
            order = await exchange.create_market_order(symbol, sig['side'], qty)
        else:
            order = await exchange.create_order(raw_symbol, 'LIMIT', sig['side'], qty, price=sig['price'])

        if order:
            log(f"🔥 ВХОД [{sig['gear'].upper()}]: {symbol} {sig['side'].upper()} | Price: {sig['price']} | Vol: {qty} | Общий баланс: ${round(memory.total_wallet, 2)}")

            # Записываем сделку в RAM под чистым биржевым ключом
            memory.active_pos[raw_symbol] = {
                'side': sig['side'], 'vol': qty, 'price': sig['price'],
                'gear': sig['gear'], 'gear_data': sig['gear_data'], 'dna': sig['dna'],
                'entry_time': time.time()
            }
            memory.tp_fixed[symbol] = False
            memory.be_fixed[symbol] = False
            memory.stop_placed[symbol] = None
            memory.slots_occupied += 1

    except Exception as e:
        log(f"⚠ Entry Error {symbol}: {e}")

