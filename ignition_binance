          #      last_ws_debug_time = time.time()
           #--------------------------------------------------------

            for sym, data in list(memory.raw_buffer.items()):
                try:
                    event_type = data.get('e', '')
                    if event_type == 'markPriceUpdate':
                        p_val = data.get('p')
                        if p_val is not None and float(p_val) > 0:
                            memory.prices[sym] = float(p_val)
                    elif event_type == 'kline':
                        kline = data.get('k', {})
                        t_ms = int(kline.get('t', 0))
                        bar = [
                            t_ms, float(kline.get('o', 0)), float(kline.get('h', 0)),
                            float(kline.get('l', 0)), float(kline.get('c', 0)), float(kline.get('v', 0))
                        ]
                        if sym not in memory.candles:
                            memory.candles[sym] = [bar]
                        else:
                            # Обновляем или добавляем свечу в скользящий массив ОЗУ
                            history = memory.candles[sym]
                            if history[-1][0] == t_ms:
                                history[-1] = bar  # Обновляем живой текущий бар
                            else:
                                history.append(bar)  # Добавляем новый закрывшийся бар
                            # Жестко держим лимит в 30 свечей в памяти для Pandas
                            if len(history) > 30:
