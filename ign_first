        current_server_time = int(time.time() * 1000)
        orders_count = 0

        for o_id, o_data in list(memory.placed_orders.items()):
#==========================   ФИКС V375.0: ТОТАЛЬНОЕ БЕССМЕРТИЕ ТИКЕРА ВЕНИКА ОЗУ   ============
            # Инициализируем имя тикера на самом верхнем уровне цикла перебора ордеров!
            # Теперь переменная доступна абсолютно всем блокам try, except и finally без единого риска краша!
            target_raw_symbol = o_data.get('symbol') if isinstance(o_data, dict) else None
#------------------------------------------------------------------------------------------------

            try:
                o_time = int(o_data['time'])
                time_passed_sec = (current_server_time - o_time) / 1000

                # Ранний зрячий лог-дебаг: бот сообщает, какие ордера он удерживает в RAM
#                log(f"⏳ [ВЕHИК ДЕБАГ]: Вижу ордер {o_id} по {o_data['symbol']} (Возраст: {round(time_passed_sec, 1)} сек)")

                if (current_server_time - o_time) >= 180000:
#                    log(f"🧹 [ВЕHИК СНОС]: Ордер {o_id} по {o_data['symbol']} устарел ({round(time_ passed_sec, 1)} сек). Попытка удаления...")
                    try:
                        clean_binance_ticker = str(o_data['binance_id']).upper().strip()
                        await asyncio.wait_for(
                            exchange.fapiPrivateDeleteOrder({'symbol': clean_binance_ticker, 'orderId': int(o_id)}),
                            timeout=5.0
                        )
#                        log(f"✅ [ЛОКАЛЬНЫЙ ВЕHИК]: Лимитка {o_id} по {o_data['symbol']} успешно выжжена из стакана.")
                        orders_count += 1
#==========================   ФИКС V188.0: ТОТАЛЬНЫЙ РАСКРЫТИЕ СЛЕПЫХ ОШИБОК ВЕНИКА   ===========
                    except asyncio.TimeoutError:
                        log(f"⚠️ [ВЕHИК КРАХ]: СЕТЕВОЙ ТАЙМАУТ! Бинанс не ответил за 2.0 сек при сносе ордера {o_id} по {o_data['symbol']}.")
                    except Exception as binance_err:
#                        log(f"ℹ️ [ВЕHИК ОТКАЗ БИРЖИ]: Бинанс отклонил запрос на отмену ордера {o_id}: {binance_err}")
#==========================   ФИКС V208.0: ПЕРЕХВАТ НАЛИТИЯ ОРДЕРА ПРИ ОТКАЗЕ ОТМЕНЫ   ==========
                        # Если Бинанс говорит Unknown order — значит, лимитка налилась в эту же миллисекунду!
                        # Мы ПРИНУДИТЕЛЬНО переводим её в статус живого контракта, запрещая Венику стирать слот!
                        if "Unknown order" in str(binance_err) and target_raw_symbol in memory.active_pos:
                            memory.active_pos[target_raw_symbol]['is_live'] = True
