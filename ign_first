async def limit_orders_cleaner_loop(exchange):
    """ Наносекундный зрячий локальный Веник ОЗУ: чистит лимитки с выводом логов V184.0 """
    while memory.is_running:
        await asyncio.sleep(10)

        if not hasattr(memory, 'placed_orders') or not memory.placed_orders:
