            is_meme = any(m in symbol.upper() for m in ['1000PEPE', 'WIF', 'POPCAT', '1000SHIB', '1000BONK', '1000FLOKI', 'DOGE'])
            base_offset = 0.05 if is_meme else 0.15
            adaptive_offset = base_offset * session_mult

            long_barrier = ma_prev * (1.0 - adaptive_offset)
            short_barrier = ma_prev * (1.0 + adaptive_offset)
#==========================================================================
           # Точечная блокировка Ножей с учетом Шлюза Паритета Дельты
            if is_buy_candidate and is_3_red:
