           return None, last_beacon_t


        # 2. РАСЧЕТ ИНДИКАТОРОВ БОЛЛИНДЖЕРА НА NUMPY
        ma_series = df['c'].rolling(20).mean()
        std_series = df['c'].rolling(20).std()

        ma = ma_series.to_numpy()
        std = std_series.to_numpy()

        ma_prev = ma[-2]
        std_prev = std[-2]

        if std_prev == 0 or ma_prev == 0 or pd.isna(ma_prev) or pd.isna(std_prev):
            return None, last_beacon_t

        p_up = ma_prev + (2.1 * std_prev)
        p_dn = ma_prev - (2.1 * std_prev)
        curr_w = (p_up - p_dn) / ma_prev * 100

        p_up_prev = ma[-3] + (2.1 * std[-3])
        p_dn_prev = ma[-3] - (2.1 * std[-3])
        if ma[-3] == 0:
            return None, last_beacon_t

        prev_w = (p_up_prev - p_dn_prev) / ma[-3] * 100
        # Если канал Боллинджера был сжат в абсолютный ноль — наносекундно отменяем ложный импульс
        if prev_w == 0:
            return None, last_beacon_t

        w_growth = curr_w / prev_w

        # 3. ФИЛЬТР 1: TREND ALTITUDE SHIELD (Запрет перегретых хаев)
        # Динамически вычисляем класс риска монеты по её тикеру
        sym_upper = symbol.upper()
        if any(mem in sym_upper for mem in ['1000PEPE', 'WIF', '1000SHIB', '1000BONK', '1000FLOKI','DOGE', 'NOT', 'POPCAT', 'JASMY']):
            max_alt_pct = 2.5   # Класс 1: Мемы (Предел отрыва от MA20 2.5%)
        elif any(tech in sym_upper for tech in ['SOL', 'NEAR', 'SUI', 'FET', 'TIA', 'APT', 'OP', 'RENDER']):
            max_alt_pct = 1.4   # Класс 2: Технологичная альта (Предел 1.4%)
        else:
            max_alt_pct = 0.8   # Класс 3: Тяжелые якоря (Предел 0.8%)

        # Измеряем текущую высоту (отрыв) живой цены от средней линии MA20
        current_altitude = abs(cur_p / ma_prev - 1) * 100

        # Если монета улетела в космос выше лимита класса — глухая блокировка ордера
        if current_altitude > max_alt_pct:
