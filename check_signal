        s_price = float(s_price_raw) if s_price_raw else cur_p
        s_basis = abs(cur_p / s_price - 1.0) * 100.0

        # 2. ШЛЮЗ ПАРИТЕТА МАРКЕТ-ДЕЛЬТЫ ОБЪЕМОВ (ЗАЩИТА ОТ АЙСБЕРГ-РАЗВОРОТОВ ММ)
