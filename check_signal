                    log(f"🪓 [KNIFE BLOCK]: Отмена Лонга по {symbol}! Адаптивный барьер или скрытый  Айсберг ММ.")
                    return None, last_beacon_t

            if is_sell_candidate and is_3_green:
                if cur_p >= short_barrier or not is_delta_safe:
                    log(f"🪓 [KNIFE BLOCK]: Отмена Шорта по {symbol}! Адаптивный барьер или скрытый  Айсберг ММ.")
                    return None, last_beacon_t


        # Финальный шлюз выдачи заполненного пакета сигнала на исполнение
        # --- [ВРЕЗКА V43.0: АДАПТИВНЫЕ ПОЛОСЫ ДНК И ТУМБЛЕР РЕЖИМА ОРДЕРА] ---
        channel_width = abs(p_up - p_dn) / ma_prev * 100.0
        is_meme = any(m in symbol.upper() for m in ['PEPE', 'WIF', 'POPCAT', 'SHIB', 'BONK', 'FLOKI', 'DOGE'])
        is_anchor = any(a in symbol.upper() for a in ['BNB', 'LINK', 'AVAX', 'ADA', 'CRV'])

        # Настраиваем индивидуальные пороги Ракета/Откат под классы монет
        if is_meme:
            rocket_threshold, rebound_pct = 3.5, 0.0048
        elif is_anchor:
            rocket_threshold, rebound_pct = 1.1, 0.0018
        else:
            rocket_threshold, rebound_pct = 1.8, 0.0030

        # Выбираем режим ордера: MARKET для истинного взрыва, LIMIT для отката
        #sig_gear = 'MARKET' if (channel_width >= rocket_threshold and w_growth >= 1.25) else 'LIMIT'

#        target_price = cur_p
        if sig_gear == 'LIMIT':
            target_price = cur_p * (1.0 - rebound_pct) if is_buy_candidate else cur_p * (1.0 + rebound_pct)

        # Контур Ножа Боллинджера: страхует только рыночные ордера
#        adaptive_offset = 0.05 if is_meme else 0.15
#        long_barrier, short_barrier = ma_prev * (1.0 - adaptive_offset), ma_prev * (1.0 + adaptive_offset)

        if sig_gear == 'MARKET':
            if is_buy_candidate and is_3_red and cur_p <= long_barrier: return None, last_beacon_t
            if is_sell_candidate and is_3_green and cur_p >= short_barrier: return None, last_beacon_t

        #log(f"⚙️ [DEBUG 2Перед ретурном параметров. Всё прошли.")


        # Жестко отсекаем ложные фантомные шорты, если условия входа не выполнены
        if not is_buy_candidate and not is_sell_candidate:
            return None, last_beacon_t

        trade_side = 'buy' if is_buy_candidate else 'sell'

        # Сверяем код: возвращаем строго те переменные, которые реально объявлены в check_signal!
        payload = {
            'symbol': symbol, 'side': trade_side,
            'price': target_price, 'gear_type': sig_gear,
            'actual_price': cur_p,  # Запечатываем чистую живую цену ОЗУ для логов дебага
            'gear': gear, 'gear_data': gd, 'dna': dna
        }
#            'symbol': symbol,
#            'side': 'buy' if is_buy_candidate else 'sell',
#            'gear': gear,
#            'price': cur_p,
#            'dna': dna,
#            'gear_data': dna[gear]
#        }
        return payload, last_beacon_t
    except Exception as err:
        log(f"⚠ [КРИТ CHECK_SIGNAL]: Скрытый обрыв входа по {symbol}: {err}")
        return None, last_beacon_t
