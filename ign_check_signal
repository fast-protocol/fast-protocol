#            if change >= speed_threshold:
#                gear = 'g1'
#----------------------------------

#        elif 'g1' in dna and change >= float(dna['g1'].get('speed', 0.0040)):
#            gear = 'g1'

        if not gear:
            # log(f"⏱️ [SPEED BLOCK]: {symbol} не пробил скорость. Текущая: {round(change*100,3)}%")
            return None, last_beacon_t

        gd = dna.get(gear, {})

        # --- ЭТАП 3: Фильтр 3-минутного накопительного объема (Топливо ракеты) ---
        v_now = float(df[-1][5]) # Индекс 5 — это объем Volume
        v_p1 = float(df[-2][5])
        v_p2 = float(df[-3][5])
        if v_now < v_p1 and v_p1 < v_p2:
            #log(f"🔍 [VOLUME SHIELD]: Отмена по {symbol}! Вялый закисающий импульс объема. v_now={v_now} < v_p1={v_p1}")
            return None, last_beacon_t

        # --- ЭТАП 4: Определение направления (Куда летим?) ---
        trade_side = 'buy' if cur_p > open_p else 'sell'
        is_buy_candidate = (trade_side == 'buy')
        is_sell_candidate = (trade_side == 'sell')
#==========================   ФИКС V1650.5: ТОЧКА №2 — КВАНТОВЫЙ ВЕКТОРНЫЙ РАДАР (15S MOMENTUM) ===
        try:
            btc_cur = float(memory.prices.get('BTC/USDT:USDT', 0))
            if btc_cur > 0 and hasattr(memory, 'btc_buffer_15s') and memory.btc_buffer_15s:
                # Извлекаем цену Биткоина ровно 15 секунд назад из начала буфера
                btc_15s_ago = float(memory.btc_buffer_15s[0][1])
                btc_momentum = btc_cur - btc_15s_ago

                # Берем индекс [5] — чистый объем минутного бара, полностью выжигая TypeError!
                is_alpha_volume = float(df[-1][5]) > (float(df[-2][5]) * 3.5) if len(df) >= 2 else False
#--------------------------------------
#==========================   ФИКС V2000.0: ПЕРЕВОД ВЕКТОРОВ НА СТАНДАРТ ЧИСТЫХ ПРОЦЕНТОВ ХОДА ==========
                # Переводим обе дельты в проценты изменения цены, полностью выжигая коллизию масштабов!
                alts_minute_pct = (cur_p / open_p - 1.0) * 100.0 if open_p > 0 else 0
                btc_open_val = float(memory.prices.get('BTC_OPEN', btc_cur))
                btc_minute_pct = (btc_cur / btc_open_val - 1.0) * 100.0 if btc_open_val > 0 else 0

                # Блокируем ШОРТ, если Биткоин падает более чем на -0.03%, а альта при этом прет в плюс!
                if is_sell_candidate and (btc_minute_pct < -0.03) and (alts_minute_pct > 0.005):
                    log(f"🚫 [ALTS STRENGTH Shield V2000.0]: Отмена SELL по {symbol}. Монета сильнее падающего BTC: {round(alts_minute_pct,3)}% vs {round(btc_minute_pct,3)}%")
                    return None, last_beacon_t

                # Блокируем ЛОНГ, если Биткоин прет вверх более чем на +0.03%, а альта при этом льется в минус!
                if is_buy_candidate and (btc_minute_pct > 0.03) and (alts_minute_pct < -0.005):
                    log(f"🚫 [ALTS WEAKNESS Shield V2000.0]: Отмена BUY по {symbol}. Монета слабее растущего BTC: {round(alts_minute_pct,3)}% vs {round(btc_minute_pct,3)}%")
                    return None, last_beacon_t
#--------------------------------
#==========================   ФИКС V1730.0: КВАНТОВЫЙ ЩИТ СВЕЧНОГО ПОГЛОЩЕНИЯ BTC (ENGULFING BARRIER) ===
                # Вытягиваем из ОЗУ-массива Биткоина предыдущую закрытую минутную свечу
                btc_candles = memory.candles.get('BTC/USDT:USDT')
                prev_btc_bar = btc_candles[-2] if btc_candles and len(btc_candles) >= 2 else None
                prev_btc_high = float(prev_btc_bar[2]) if prev_btc_bar else btc_cur
                prev_btc_low = float(prev_btc_bar[3]) if prev_btc_bar else btc_cur

                # Блокируем ЛОНГ, если Биткоин льется за 15с И при этом текущая цена пробила ЛОУ предыдущей закрытой свечи Биткоина
                if is_buy_candidate and (btc_momentum < -35.0) and (btc_cur < prev_btc_low) and not is_alpha_volume:
                    #log(f"🚫 [BTC ENGULF-L V1730.0]: Отмена BUY по {symbol}. Истинное поглощение лоу BTC: {btc_cur} < {prev_btc_low}")
                    return None, last_beacon_t

                # Блокируем ШОРТ, если Биткоин прет вверх за 15с И при этом текущая цена пробила ХАЙ предыдущей закрытой свечи Биткоина
                if is_sell_candidate and (btc_momentum > 35.0) and (btc_cur > prev_btc_high) and not is_alpha_volume:
                    #log(f"🚫 [BTC ENGULF-S V1730.0]: Отмена SELL по {symbol}. Истинное поглощение хай BTC: {btc_cur} > {prev_btc_high}")
                    return None, last_beacon_t
#--------------------------------
        except Exception as btc_shield_err:
            log(f"🚨 [КРАШ ВЕКТОРНОГО РАДАРА]: {btc_shield_err}")
#---------------------------------
        # --- ЭТАП 5: Канонический Пре-Свечной Каскадный Нож (Защита от излета тренда) ---
        bar_1 = df[-2]
        bar_2 = df[-3]
        bar_3 = df[-4]
        is_3_green = (float(bar_1[4]) > float(bar_1[1])) and (float(bar_2[4]) > float(bar_2[1])) and (float(bar_3[4]) > float(bar_3[1]))
        is_3_red = (float(bar_1[4]) < float(bar_1[1])) and (float(bar_2[4]) < float(bar_2[1])) and (float(bar_3[4]) < float(bar_3[1]))

        if is_buy_candidate and is_3_red:
            #log(f"🚫 [CANDLE SHIELD]: Падающий нож по {symbol}. Запрет ЛОНГА.")
            return None, last_beacon_t
        if is_sell_candidate and is_3_green:
            #log(f"🚫 [CANDLE SHIELD]: Растущая ракета по {symbol}. Запрет ШОРТА.")
            return None, last_beacon_t
#==========================   ПРАВКА V790.0: ИНДЕКСНЫЙ ВОЗВРАТ КУПОЛА TREND ALTITUDE SHIELD ===
        # Вычисляем истинную скользящую среднюю ma20 на лету по 20 последним Close-ценам списка (индекс 4)
        try:
            recent_closes = [float(b[4]) for b in df[-20:]]
            ma20 = sum(recent_closes) / len(recent_closes)
            current_altitude = abs(cur_p / ma20 - 1.0)

            # Динамические лимиты отрыва по классам твоей ДНК
            max_altitude = 0.0350 if is_meme else (0.0140 if is_tech else 0.0080)

            if current_altitude > max_altitude:
                #log(f"🚫 [ALTITUDE SHIELD V790.0]: {clean_symbol} перегрет! Отрыв {round(current_altitude*100,2)}% > {round(max_altitude*100,2)}%")
                return None, last_beacon_t
        except Exception as altitude_crash_err:
            log(f"🚨 [КРАШ ФИЛЬТРА ALTITUDE]: {altitude_crash_err}")
#------------------------------------

        # --- АДАПТИВНЫЙ КОМПЕНСАТОР СЕТЕВОГО ЛАГА БИHАHСА (РАСЧЕТ ТАРГЕТ-ЦЕНЫ) ---
        rebound_pct = 0.0048 if is_meme else (0.0024 if is_tech else 0.0012)
        target_price = cur_p * (1.0 - rebound_pct) if is_buy_candidate else cur_p * (1.0 + rebound_pct)
        target_price = float(exchange.price_to_precision(symbol, target_price))
        sig_gear = 'LIMIT'

        # БOЕВОЙ СИГHАЛ
        #log(f"🚀 🔥 [ИМПУЛЬСНЫЙ СИГНАЛ {gear.upper()}]: {symbol} | Side: {trade_side.upper()} | Speed: {round(change*100,2)}% | BB: {round(w_growth*100,2)}%")

        payload = {
            'symbol': symbol, 'side': trade_side,
            'price': target_price, 'gear_type': sig_gear,
            'actual_price': cur_p,
            'gear': gear, 'gear_data': gd, 'dna': dna
        }
        return payload, int(time.time() * 1000)

    except Exception as signal_crash_err:
        log(f"🚨 [КРИТ_КРАШ СКАHЕРА check_signal] по {symbol}: {signal_crash_err}")
        return None, last_beacon_t
