#                return None, last_beacon_t

        # --- ЭТАП 1: Оценка накопления и сжатия пружины (Ленты Боллинджера) ---
#==========================   ФИКС V770.0: ЧЕСТНЫЙ МАТЕМАТИЧЕСКИЙ РАСЧЕТ ШИРИНЫ ИЗ ОЗУ-СПИСКА ===
#==========================   ПРАВКА V850.0: АДАПТИВНЫЙ ФИЛЬТР ВОЛАТИЛЬНОСТИ ПО ШИРИНЕ BB =======
        # Рассчитываем честную текущую ширину Боллинджера по последним 20 сокет-свечам из списка Close (индекс 4)
        try:
            recent_closes = [float(b[4]) for b in df[-20:]]
            sma_20 = sum(recent_closes) / len(recent_closes)
            variance = sum((x - sma_20) ** 2 for x in recent_closes) / len(recent_closes)
            std_dev = variance ** 0.5
            bb_upper = sma_20 + (2 * std_dev)
            bb_lower = sma_20 - (2 * std_dev)
            w_growth = (bb_upper - bb_lower) / bb_lower if bb_lower > 0 else 0.035
        except:
            w_growth = 0.0

#        if w_growth >= float(dna.get('w_grow', 0.035)):
#            return None, last_beacon_t
        # Динамические макро-пороги сжатия пружины Боллинджера перед взрывом импульса
        # Мемы требуют больше воздуха, Тех-драйверы обязаны быть жестко зажаты во флэт!
        max_bb_allowed = 0.0550 if is_meme else (0.0240 if is_tech else 0.0160)

        # Если канал шире адаптивного порога — монета уже находится в фазе мясорубки, отмена!
        if w_growth >= max_bb_allowed:
            # log(f"💤 [BB_WIDTH OVERHEAT]: Отмена по {clean_symbol}. Канал расширен: {round(w_growth*100,2)}% >= {round(max_bb_allowed*100,2)}%")
            return None, last_beacon_t

        # Жесткие HFT-пороги минимальной волатильности по классам ДНК для отсечки ночного мертвого флэта
        min_required_volatility = 0.0080 if is_meme else (0.0035 if is_tech else 0.0020)

        # Если рынок спит и ширина канала Боллинджера меньше порога — наглухо блокируем ложные входы!
        if w_growth < min_required_volatility:
            # log(f"💤 [FLAT DROP V850.0]: Отмена по {clean_symbol}. Рынок спит: {round(w_growth*100,3)}% < {min_required_volatility*100}%")
            return None, last_beacon_t
#---------------------------------

        # --- ЭТАП 2: Твой оригинальный тумблер двух скоростей (G1 / G2) — Взлет Ракеты! ---
        open_p = float(last_bar[1]) # Индекс 1 — это цена Open минутного баре
        change = abs(cur_p / open_p - 1)
        gear = None

        if 'g2' in dna and change >= float(dna['g2'].get('speed', 0.0120)):
            gear = 'g2'
#==========================   ФИКС V1010.0: РАЗЖАТИЕ МЕМЕ-ШЛЮЗОВ СКОРОСТИ G1 ПО КЛАССАМ ДНК =======
        elif 'g1' in dna:
            import datetime
            is_weekend = datetime.datetime.now().weekday() in [5, 6]

            # Разделяем пороги: Мемы требуют большего импульса, чтобы отсечь сокетный шум!
            if is_meme:
                speed_threshold = 0.0045 if is_weekend else 0.0075
            else:
                speed_threshold = 0.0025 if is_weekend else float(dna['g1'].get('speed', 0.0040))

            if change >= speed_threshold:
                gear = 'g1'
#-----------------------------------
#==========================   ФИКС V825.0: ТОЧКА №1 — АДАПТИВНАЯ СКОРОСТЬ КЛАССА G1 ПОД ВЫХОДНЫЕ ===
#        elif 'g1' in dna:
#            import datetime
#            # На лету определяем день недели в ОЗУ: 5 — Суббота, 6 — Воскресенье
#            is_weekend = datetime.datetime.now().weekday() in [5, 6]
