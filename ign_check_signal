        if hasattr(memory, 'blacklist_coins') and any(pure_token in str(k).upper() for k in list(memory.blacklist_coins.keys())):
            # Локально определяем точный ключ фантома, под которым застрял штраф в памяти ОЗУ
            found_key = [k for k in list(memory.blacklist_coins.keys()) if pure_token in str(k).upper()][0]
            time_passed_after_sl = time.time() - memory.blacklist_coins[found_key]
            if time_passed_after_sl < 300:
                return None, last_beacon_t
            else:
                if found_key in memory.blacklist_coins: del memory.blacklist_coins[found_key]
#----------------------------------
#            if time_passed_after_sl < 300:
#                return None, last_beacon_t
#            else:
#                if symbol in memory.blacklist_coins:
#                    del memory.blacklist_coins[symbol]

