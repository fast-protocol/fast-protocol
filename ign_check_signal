                return None, last_beacon_t
#-----------------------------------

        is_meme = any(meme in token_upper for meme in ['1000PEPE', '1000SHIB', '1000BONK', '1000FLOKI', 'WIF', 'POPCAT', 'DOGE', 'MEME'])
        is_tech = any(tech in token_upper for tech in ['SOL', 'TRB', 'APT', 'FIL', 'RENDER', 'FET', 'OP', 'STORJ', 'GLM', 'TIA', 'AEVO', 'C98'])

        # --- КОНТУР 1: СПОТ-ФЬЮЧЕРСНЫЙ АРБИТРАЖНЫЙ ШЛЮЗ (SPOOFING DETECTOR) ---
#==========================   ФИКС V2900.0: СВЕРХБЫСТРЫЙ REST-ЗАПРОС ЦЕНЫ СПОТА БИHАНСА ДЛЯ ШИЛДА =======
#==========================   ФИКС V2970.0: ТОТАЛЬНАЯ КАНOНИЧEСКAЯ ОЧИСТКА ТИКЕРА СПОТА ============
        try:
#==========================   ФИКС V3020.0: СВЕРХБЕЗОПАСНЫЙ МОНОЛИТНЫЙ КОНТУР РАСЧЕТА ЦЕНЫ СПОТА ===
            # Вырезаем базовый тикер. Если это копеечный мем — убираем 1000 и сносим слэш для спота Бинанса!
            raw_base_id = str(symbol).split(':')[0].upper()
            if any(m in raw_base_id for m in ['1000PEPE', '1000SHIB', '1000BONK', '1000FLOKI']):
                spot_clean = raw_base_id.replace('1000', '').replace('/', '')
            else:
                spot_clean = raw_base_id

            # Наносекундно выдергиваем живой спот из REST API Бинанса strictly в момент сигнала по ВСЕМ монетам!
            spot_data = await exchange.fetch_ticker(spot_clean)

            # Прямая, защищенная от NoneType и NameError десериализация цены спота
            if spot_data and spot_data.get('last') is not None:
                spot_price = float(spot_data.get('last'))
#==========================   ФИКС V3050.0: МАТЕМАТИЧЕСКОЕ ВЫРАВНИВАНИЕ МАСШТАБОВ ЦЕН МЕМОВ X1000 ======
                # Если пара является фьючерсным мемом группы 1000 — восстанавливаем масштаб спота для верного базиса!
                if any(m in raw_base_id for m in ['1000PEPE', '1000SHIB', '1000BONK', '1000FLOKI']):
                    spot_price = spot_price * 1000.0
            else:
                spot_price = float(cur_p)
#---------------------------
            if spot_price > 0:
                basis_pct = abs(cur_p / spot_price - 1.0) * 100.0
                if basis_pct >= 0.25:
                    #log(f"🛑 [SPOOFING SHIELD V2900.0]: Отмена по {symbol}! Фьючерс оторвался от Спота! Базис: {round(basis_pct, 3)}% >= 0.25%")
                    return None, last_beacon_t
        except Exception as spot_api_err:
            log(f"🛑 [КРАШ SPOOFING SHIELD V2900.0]: Ошибка: {spot_api_err}")
            pass

#==========================   ФИКС V3360.0: ТОЧНЫЙ ЗАБОР ИНДЕКСОВ ОБЪЕМОВ ЗАКРЫТЫХ СВЕЧЕЙ BTC/ALTS =======
        try:
            # Забираем шестой элемент (индекс 5) из закрытых массивов ОЗУ, полностью уничтожая TypeError!
            v_now = float(df[-2][5]) if (df and len(df) >= 2) else 0
            v_p1 = float(df[-3][5]) if (df and len(df) >= 3) else 1

            if v_now < (v_p1 * 1.25):
                #log(f"🚫 [VOLUME DELTA SHIELD V3360.0]: Отмена по {symbol}! Пустой сквиз ММ без реальных торгов: v_now={round(v_now,1)} < v_p1*2.5={round(v_p1*2.5,1)}")
                return None, last_beacon_t
        except Exception as vol_shield_crash:
