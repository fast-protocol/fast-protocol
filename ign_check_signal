        # Извлекаем массив минутных баров на самом верхнем уровне функции для всех макро-фильтров
        df = memory.candles.get(symbol)
        if df is None or len(df) < 30: return None, last_beacon_t
#--------------------------------------
        try:
            recent_120_closes = [float(b[4]) for b in df[-120:]] if len(df) >= 120 else [float(b[4]) for b in df]
            macro_high = max(recent_120_closes)
            macro_low = min(recent_120_closes)
            macro_change_pct = (macro_high - macro_low) / macro_low if macro_low > 0 else 0.0

            #token_upper = str(symbol).upper()
            token_upper = str(symbol).split('/')[0].upper()
            is_meme_coin = any(meme in token_upper for meme in ['1000PEPE', '1000SHIB', '1000BONK', '1000FLOKI', 'WIF', 'POPCAT', 'DOGE', 'MEME'])
            is_tech_coin = any(tech in token_upper for tech in ['SOL', 'TRB', 'APT', 'FIL', 'RENDER', 'FET', 'OP', 'STORJ', 'GLM', 'TIA', 'AEVO', 'C98'])

            # Назначение прецизионных макро-порогов по твоим трем классам ДНК
            max_macro_allowed = 0.0750 if is_meme_coin else (0.0450 if is_tech_coin else 0.0280)

