#---------------------------------
#---------------------------------
        # --- КОНТУР 2: СВЕРХСКОРОСТНОЙ ШЛЮЗ ПЛОТНОСТИ ОЗУ (СПРЕД МАРКЕТ-МЕЙКЕРОВ ПО СЫРОМУ TICKER КЛЮЧУ) ---
        # Запрашиваем Bid/Ask строго по полному сырому ключу symbol, который гарантированно наполняется сокетами!
#        bid = float(memory.prices.get(f"{clean_symbol}USDT_bid", 0))
#        ask = float(memory.prices.get(f"{clean_symbol}USDT_ask", 0))

        # ВРЕМЕННЫЙ ЖИВОЙ ДЕБАГ В КОНСОЛЬ - УБЕРИ КОММЕНТ ЕСЛИ НУЖНО
