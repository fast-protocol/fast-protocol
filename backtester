def download_asset_history(exchange, symbol, timeframe, days):
    """Внутренний пагинатор: скачивает и кэширует на диск чистые бары с авто-переименованием шапки"""
    clean_name = symbol.replace('/', '_').replace(':', '_')
    csv_path = f"/root/hft_archive/{clean_name}_{timeframe}.csv"

    if os.path.exists(csv_path):
        df = pd.read_csv(csv_path)
        if 'open_time' in df.columns: df.rename(columns={'open_time': 'timestamp'}, inplace=True)
        return df

    total_needed = days * 24 * 60
    all_candles = []
    since = exchange.milliseconds() - (total_needed * 60 * 1000)

    while len(all_candles) < total_needed:
        try:
            limit_chunk = min(1000, total_needed - len(all_candles))
            ohlcv = exchange.fetch_ohlcv(symbol, timeframe, since=since, limit=limit_chunk)
            if not ohlcv: break
            all_candles.extend(ohlcv)
            since = ohlcv[-1][0] + 60 * 1000
            time.sleep(0.1)
        except Exception as e:
            time.sleep(2)

    df = pd.DataFrame(all_candles, columns=['timestamp', 'open', 'high', 'low', 'close', 'volume'])
    df.drop_duplicates(subset=['timestamp'], inplace=True)
    df.sort_values(by='timestamp', inplace=True)
    df.reset_index(drop=True, inplace=True)

    os.makedirs('/root/hft_archive/', exist_ok=True)
    df.to_csv(csv_path, index=False)
    return df

def load_synchronized_macro_packet(symbol, timeframe='1m', days=30):
    """
    🦅 СHHХРOHИЗAТOР МAКРO-ПОТOКOВ: Скачивает и склеивает Тройной Массив данных
    [Фьючерсы Монеты + Биткоин Фьючерсы + Спот Монеты] миллисекунда в миллисекунду!
    """
    import ccxt
    exchange = ccxt.binance({'enableRateLimit': True})

    print(f"📡 [HFT-SYNCHRONIZER]: Сборка синхронизированного макро-пакета за {days} дней по {symbol}...")

    # Стягиваем/поднимаем три независимых локальных архива
    df_fut = download_asset_history(exchange, symbol, timeframe, days)
    df_btc = download_asset_history(exchange, "BTC/USDT:USDT", timeframe, days)

    spot_symbol = symbol.split(':')[0].replace('/', '') # Превращаем TIA/USDT:USDT в TIAUSDT для спота
    df_spot = download_asset_history(exchange, f"{symbol.split('/')[0]}/USDT", timeframe, days)

    # Ювелирно склеиваем три таблицы по общей временной шкале timestamp
    df_btc = df_btc[['timestamp', 'close']].rename(columns={'close': 'btc_close'})
    df_spot = df_spot[['timestamp', 'close']].rename(columns={'close': 'spot_close'})

    m1 = pd.merge(df_fut, df_btc, on='timestamp', how='inner')
    df_final = pd.merge(m1, df_spot, on='timestamp', how='inner')
    df_final.sort_values(by='timestamp', inplace=True)
    df_final.reset_index(drop=True, inplace=True)

    print(f"💎 [SYNC-SUCCESS]: Склеен тройной монолит из {len(df_final)} синхронных макро-барів!")
    return df_final


def generate_sub_candle_ticks(open_p, high_p, low_p, close_p, volume_p):
    """
    🔬 СТРУКТУРНЫЙ ГЕНЕРАТОР ТИКОВ СВЕЧИ V6.6 (True Volume & Vector Replay)
    Распределяет объемы и полярность тиков строго согласно реальной физике минутной свечи!
    Концентрирует 70% ликвидности на пробитиях экстремумов High/Low цент в цент!
    """
    # Создаем 6 ключевых потиковых фаз движения цены внутри минутного бара
    if close_p >= open_p:
        # Зеленая свеча: Open -> Low (разгон) -> High (HFT-пробой) -> Close
        price_steps = [open_p, low_p, (low_p + high_p)/2, high_p, (high_p + close_p)/2, close_p]
        vectors = ['sell', 'sell', 'buy', 'buy', 'sell', 'buy']
    else:
        # Красная свеча: Open -> High (разгон) -> Low (HFT-пробой) -> Close
        price_steps = [open_p, high_p, (high_p + low_p)/2, low_p, (low_p + close_p)/2, close_p]
        vectors = ['buy', 'buy', 'sell', 'sell', 'buy', 'sell']

    ticks = []
    for idx, price in enumerate(price_steps):
        # Эмулируем HFT-всплеск объема: на экстремумах (индексы 1 и 3) вливается 70% ликвидности свечи!
        if idx in [1,3]:
            tick_vol = volume_p * 0.35
        else:
            tick_vol = volume_p * 0.075

        ticks.append({
            'price': float(price),
            'volume': float(tick_vol),
            'vector': vectors[idx]
        })
    return ticks
